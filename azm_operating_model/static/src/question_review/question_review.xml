<?xml version="1.0" encoding="UTF-8"?>
<templates xml:space="preserve">

<t t-name="azm_operating_model.QuestionReview">
    <div class="o_action o_azm_dashboard o_azm_om o_azm_qr" dir="rtl">
        <div t-if="!this.d.home" class="o_azm_loading">
            <i class="oi oi-spin" data-icon="progress_activity" title="Loading"/>
        </div>

        <!-- الصفحة الأولى: النموذجان، بالشكل الذي تُقرأ به «مساحتي» -->
        <t t-elif="!this.d.model">
            <header class="o_azm_qr_hero">
                <span class="o_azm_qr_hero_mark">
                    <i class="oi" data-icon="fact_check" title="Question review"/>
                </span>
                <div class="o_azm_qr_hero_words">
                    <h1>مساحتي للمراجعة <small>My review work</small></h1>
                    <p>
                        <t t-out="this.d.home.user"/>
                        — اقرأ السؤال وقل رأيك فيه: أواضح هو، أمكرر، أينقصه خيار.
                        <small class="o_azm_en">Read each question, say what you think of it,
                            then send your notes to the model's administrator.</small>
                    </p>
                </div>
            </header>

            <section class="o_azm_kpis">
                <div t-foreach="this.kpis" t-as="kpi" t-key="kpi.key"
                     t-attf-class="o_azm_kpi o_azm_kpi_static o_azm_tone_{{kpi.tone}}">
                    <span class="o_azm_kpi_text">
                        <span class="o_azm_kpi_label">
                            <t t-out="kpi.label"/><em class="o_azm_kpi_en" t-out="kpi.en"/>
                        </span>
                        <strong class="o_azm_kpi_value" t-out="kpi.value"/>
                        <small t-out="kpi.sub"/>
                    </span>
                    <span class="o_azm_icon_badge">
                        <i class="oi" t-att-data-icon="kpi.icon" t-att-title="kpi.label"/>
                    </span>
                </div>
            </section>

            <section class="o_azm_qr_models">
                <h2 class="o_azm_qr_section">
                    ما عليك مراجعته <em class="o_azm_en">What you review</em>
                </h2>
                <div class="o_azm_card">
                    <div t-foreach="this.d.home.models" t-as="m" t-key="m.key"
                         class="o_azm_qr_model_row">
                        <span t-attf-class="o_azm_icon_badge o_azm_tone_{{m.tone}}">
                            <i class="oi" t-att-data-icon="m.icon" t-att-title="m.name"/>
                        </span>
                        <div class="o_azm_qr_model_main">
                            <b t-out="m.name"/>
                            <small class="o_azm_en" t-out="m.en"/>
                            <div class="o_azm_qr_model_meter">
                                <span t-attf-class="o_azm_qr_meter o_azm_tone_{{m.tone}}">
                                    <span t-attf-style="width: {{m.progress || 0}}%"/>
                                </span>
                                <small>
                                    راجعتُ <t t-out="m.reviewed"/> من <t t-out="m.total"/> سؤالًا
                                    <t t-if="m.total - m.reviewed"> · بقي
                                        <b t-out="m.total - m.reviewed"/></t>
                                    <t t-else=""> · اكتملت</t>
                                </small>
                            </div>
                        </div>
                        <div class="o_azm_qr_model_side">
                            <span t-if="m.drafts" class="o_azm_qr_chip o_azm_qr_chip_draft">
                                <t t-out="m.drafts"/> مسودة
                            </span>
                            <span t-if="m.sent" class="o_azm_qr_chip o_azm_qr_chip_sent">
                                <t t-out="m.sent"/> مُرسَلة
                            </span>
                            <small t-if="m.needs_work" class="text-muted">
                                منها <t t-out="m.needs_work"/> تحتاج تعديلًا
                            </small>
                        </div>
                        <div class="o_azm_qr_model_actions">
                            <button type="button" class="btn btn-sm btn-primary"
                                    t-on-click="() => this.openModel(m.key)">
                                <i class="oi me-1" data-icon="edit_note"/>
                                ابدأ
                            </button>
                        </div>
                    </div>
                </div>
            </section>

            <section t-if="this.draftCount" class="o_azm_qr_send_all">
                <div class="o_azm_card">
                    <span class="o_azm_icon_badge o_azm_tone_orange">
                        <i class="oi" data-icon="outgoing_mail" title="Send"/>
                    </span>
                    <div class="o_azm_qr_model_main">
                        <b>عندك <t t-out="this.draftCount"/> ملاحظة لم تُرسل بعد</b>
                        <small class="o_azm_en">Notes you have written but not yet sent.</small>
                    </div>
                    <button type="button" class="btn btn-sm btn-primary"
                            t-on-click="() => this.sendAll()">
                        <i class="oi me-1" data-icon="send"/>
                        أرسلها إلى مدير النموذج
                    </button>
                </div>
            </section>
        </t>

        <!-- داخل نموذج: الأقسام والأسئلة، والرأي تحت كل سؤال -->
        <t t-else="">
            <div class="o_azm_qr_bar_top">
                <button type="button" class="btn btn-sm btn-light"
                        t-on-click="() => this.backHome()">
                    <i class="oi me-1" data-icon="arrow_forward"/>مساحتي
                </button>
                <b t-out="this.modelName(this.d.model)"/>
                <span t-if="this.d.data" class="o_azm_qr_muted">
                    <t t-out="this.d.data.title"/> — راجعتُ <t t-out="this.d.data.reviewed"/>
                    من <t t-out="this.d.data.count"/>
                </span>
                <input type="search" class="form-control form-control-sm o_azm_qr_search"
                       placeholder="ابحث بالكود أو النص"
                       t-att-value="this.d.search"
                       t-on-input="(ev) => this.state.search = ev.target.value"/>
                <span t-if="this.d.saving" class="o_azm_qr_muted">يحفظ…</span>
                <!-- الإرسال حيث يُكتب الرأي، لا في صفحة لا يمرّ بها من يعمل هنا -->
                <button t-if="this.draftCount" type="button"
                        class="btn btn-sm btn-primary o_azm_qr_send_here"
                        t-on-click="() => this.sendAll()">
                    <i class="oi me-1" data-icon="send"/>
                    أرسل <t t-out="this.draftCount"/> ملاحظة إلى مدير النموذج
                </button>
            </div>

            <div class="o_azm_qr_body">
                <nav class="o_azm_qr_rail">
                    <button t-foreach="this.d.nodes" t-as="n" t-key="n.code" type="button"
                            t-attf-class="o_azm_qr_rail_item {{n.code === this.d.node ? 'o_azm_active' : ''}}"
                            t-on-click="() => this.openNode(n.code)">
                        <span class="o_azm_qr_rail_name" t-out="n.name"/>
                        <small><t t-out="n.reviewed"/>/<t t-out="n.questions"/></small>
                    </button>
                </nav>

                <section class="o_azm_qr_questions">
                    <t t-if="!this.d.data">
                        <div class="o_azm_qr_muted">اختر قسمًا.</div>
                    </t>
                    <t t-else="">
                        <div t-if="!this.visibleGroups().length" class="o_azm_qr_muted">
                            لا أسئلة تطابق البحث في هذا القسم.
                        </div>
                        <t t-foreach="this.visibleGroups()" t-as="g" t-key="g.key">
                            <h3 class="o_azm_qr_group" t-out="g.name"/>
                            <div t-foreach="this.questionsOf(g)" t-as="q" t-key="q.id"
                                 t-attf-class="o_azm_qr_q {{q.note ? 'o_azm_has_note' : ''}}">
                                <div class="o_azm_qr_q_head">
                                    <span class="o_azm_qr_code" t-out="q.code"/>
                                    <span class="o_azm_qr_label" t-out="q.label"/>
                                </div>
                                <p t-if="q.hint" class="o_azm_qr_hint" t-out="q.hint"/>
                                <div t-if="q.options.length" class="o_azm_qr_options">
                                    <t t-foreach="q.options" t-as="o" t-key="o_index">
                                        <span class="o_azm_qr_opt" t-out="o"/>
                                    </t>
                                </div>

                                <!-- الرأي، تحت السؤال حيث يُقرأ -->
                                <div class="o_azm_qr_note">
                                    <!-- الحالة الغالبة بضغطة: لا شيء على السؤال -->
                                    <button type="button"
                                            t-attf-class="o_azm_qr_ok {{this.isApproved(q) ? 'o_azm_active' : ''}}"
                                            t-att-disabled="q.note and q.note.state === 'sent' ? 'disabled' : undefined"
                                            t-att-title="this.isApproved(q) ? 'اضغط لتتراجع' : 'هذا السؤال سليم ولا يحتاج تغييرًا'"
                                            t-on-click="() => this.approve(q)">
                                        <i class="oi me-1"
                                           t-att-data-icon="this.isApproved(q) ? 'check_circle' : 'check'"/>
                                        <t t-if="this.isApproved(q)">سليم — لا يحتاج تغييرًا</t>
                                        <t t-else="">سليم، لا يحتاج تغييرًا</t>
                                    </button>
                                    <select class="form-select form-select-sm"
                                            t-att-disabled="q.note and q.note.state === 'sent' ? 'disabled' : undefined"
                                            t-on-change="(ev) => this.saveNote(q, {verdict: ev.target.value})">
                                        <t t-foreach="this.verdicts()" t-as="v" t-key="v.key">
                                            <option t-att-value="v.key"
                                                    t-att-selected="(q.note ? q.note.verdict : 'wording') === v.key"
                                                    t-out="v.name"/>
                                        </t>
                                    </select>
                                    <textarea class="form-control form-control-sm" rows="2"
                                              placeholder="ما رأيك في هذا السؤال؟"
                                              t-att-disabled="q.note and q.note.state === 'sent' ? 'disabled' : undefined"
                                              t-att-value="q.note ? q.note.comment : ''"
                                              t-on-change="(ev) => this.saveNote(q, {comment: ev.target.value})"/>
                                    <span t-if="q.note and q.note.state === 'sent'"
                                          class="o_azm_qr_sent">مُرسَلة — لا تُعدَّل</span>
                                </div>
                            </div>
                        </t>
                    </t>
                </section>
            </div>
        </t>
    </div>
</t>

</templates>
