<?xml version="1.0" encoding="UTF-8"?>
<templates xml:space="preserve">

    <t t-name="azm_operating_model.AzmWorkspace">
        <div class="o_azm_workspace" dir="rtl" t-if="this.state.data">
            <t t-set="d" t-value="this.state.data"/>

            <!-- header -->
            <header class="o_azm_ws_header">
                <div class="o_azm_ws_title">
                    <span class="o_azm_ws_eyebrow">AZM · Enterprise Operating Model</span>
                    <h2>
                        <t t-out="d.header.entity"/>
                        <small> · <t t-out="d.header.kind"/> · <t t-out="d.header.scenario"/></small>
                    </h2>
                </div>
                <div class="o_azm_ws_meta">
                    <span t-attf-class="o_azm_pill o_azm_state_{{d.header.state}}" t-out="d.header.state_label"/>
                    <span t-if="d.header.is_demo" class="o_azm_pill o_azm_state_demo">مثال افتراضي</span>
                    <span class="o_azm_pill">v<t t-out="d.header.version"/></span>
                    <div class="o_azm_progress" t-att-title="d.header.progress + '%'">
                        <div t-attf-style="width: {{d.header.progress}}%"/>
                    </div>
                    <span class="o_azm_muted"><t t-out="d.header.progress"/>٪</span>
                    <button type="button" t-if="d.header.can_send" class="btn btn-primary btn-sm"
                            t-att-disabled="this.state.busy"
                            t-on-click="() => this.requestReview()">
                        اطلب المراجعة <em class="o_azm_en">Request review</em>
                    </button>
                    <button type="button" t-if="d.header.can_return" class="btn btn-outline-warning btn-sm"
                            t-att-disabled="this.state.busy"
                            t-on-click="() => this.startReturn('stage', d.stage.id, d.stage.name)">
                        أعد هذه المرحلة <em class="o_azm_en">Send this stage back</em>
                    </button>
                    <button type="button" class="btn btn-secondary btn-sm" t-on-click="() => this.openRecord()">
                        <t t-out="d.header.name"/>
                    </button>
                </div>
            </header>

            <!-- why a part came back, read beside the questions -->
            <div t-if="d.header.returns.length" class="o_azm_ws_returns">
                <div t-foreach="d.header.returns" t-as="item" t-key="item.id" class="o_azm_ws_return">
                    <i class="oi" data-icon="undo" title="عاد"/>
                    <div>
                        <b><t t-out="item.part"/></b>
                        <p t-out="item.note"/>
                        <small>أعادها <t t-out="item.reviewer"/></small>
                    </div>
                </div>
            </div>

            <div t-if="this.state.returning" class="o_azm_ws_compose">
                <label>
                    سبب الإعادة — <b t-out="this.state.returning.name"/>
                    <em class="o_azm_en">Why it is coming back</em>
                </label>
                <textarea class="form-control" rows="3" placeholder="ما الذي يحتاج معالجة؟"
                          t-att-value="this.state.returnNote"
                          t-on-input="(ev) => this.state.returnNote = ev.target.value"/>
                <div class="o_azm_ws_compose_actions">
                    <button type="button" class="btn btn-sm btn-light" t-on-click="() => this.cancelReturn()">
                        تراجع
                    </button>
                    <button type="button" class="btn btn-sm btn-warning"
                            t-att-disabled="this.state.busy or !this.state.returnNote.trim()"
                            t-on-click="() => this.confirmReturn()">
                        أعدها مع الملاحظة
                    </button>
                </div>
            </div>

            <div class="o_azm_ws_body">
                <!-- stage rail -->
                <nav class="o_azm_rail">
                    <label class="o_azm_ws_filter">
                        <input type="checkbox" t-att-checked="this.state.onlyOpen"
                               t-on-change="() => this.toggleOnlyOpen()"/>
                        غير المكتمل فقط
                    </label>
                    <!-- offered only when something actually came back, so it cannot be
                         switched on to reveal an empty page for no reason -->
                    <label t-if="d.returns_open" class="o_azm_ws_filter o_azm_ws_returned_filter">
                        <input type="checkbox" t-att-checked="this.state.onlyReturned"
                               t-on-change="() => this.toggleOnlyReturned()"/>
                        المُعاد من المراجع فقط
                        <span class="o_azm_returned_count" t-out="d.returns_open"/>
                    </label>
                    <t t-foreach="d.stages" t-as="stage" t-key="stage.id">
                        <button type="button" t-attf-class="o_azm_rail_item o_azm_status_{{stage.status}} {{stage.id === this.state.stageId ? 'o_azm_active' : ''}}"
                                t-on-click="() => this.selectStage(stage)">
                            <span class="o_azm_rail_idx" t-out="stage_index + 1"/>
                            <span class="o_azm_rail_text">
                                <span class="o_azm_rail_name" t-out="stage.name"/>
                                <span class="o_azm_rail_sub">
                                    <t t-out="stage.answered"/>/<t t-out="stage.total"/> إجابة
                                    <span t-if="stage.risks" class="o_azm_risk_dot" t-out="stage.risks"/>
                                </span>
                                <span class="o_azm_rail_bar"><span t-attf-style="width: {{this.stagePercent(stage)}}%"/></span>
                            </span>
                        </button>
                    </t>
                </nav>

                <!-- questions -->
                <section class="o_azm_questions">
                    <div class="o_azm_stage_intro">
                        <span class="o_azm_code">PUR-<t t-out="d.stage.code"/></span>
                        <h3 t-out="d.stage.name"/>
                        <p class="o_azm_muted">
                            المدخل: <t t-out="d.stage.input"/> · المخرج: <t t-out="d.stage.output"/>
                        </p>
                        <div t-if="d.header.readonly" class="o_azm_note o_azm_note_warn">
                            الإفادة في حالة «<t t-out="d.header.state_label"/>» — للقراءة فقط.
                        </div>
                        <!-- what came back may be under another stage: say where it is
                             rather than leaving a page that looks empty by mistake -->
                        <div t-if="this.state.onlyReturned and !this.returnedHere()" class="o_azm_note">
                            لا شيء مُعاد في هذه المرحلة — المُعاد (<t t-out="d.returns_open"/>)
                            في مراحل أخرى، اختر منها من القائمة.
                        </div>
                    </div>

                    <t t-foreach="d.groups" t-as="group" t-key="group.key">
                        <t t-set="items" t-value="this.questionsOf(group.key)"/>
                        <div t-if="items.length" class="o_azm_group_card">
                            <h4 t-out="group.title"/>
                            <t t-foreach="items" t-as="q" t-key="q.id">
                                <div t-attf-class="o_azm_q {{this.isAnswered(q) ? 'o_azm_q_done' : ''}}">
                                    <div class="o_azm_q_head">
                                        <span class="o_azm_q_label" t-out="q.label"/>
                                        <span class="o_azm_code" t-out="q.code"/>
                                        <button type="button" t-if="q.help" class="btn btn-link btn-sm p-0"
                                                t-on-click="() => this.toggleHelp(q)">؟</button>
                                        <!-- one question back, rather than the stage it sits in -->
                                        <button type="button" t-if="d.header.can_return"
                                                class="o_azm_chip o_azm_chip_soft o_azm_return_chip"
                                                title="أعد هذا السؤال مع ملاحظة"
                                                t-on-click="() => this.startReturn('question', q.id, q.label)">
                                            <i class="oi" data-icon="undo" title="أعد"/> أعده
                                        </button>
                                    </div>
                                    <p t-if="this.state.showHelp[q.id]" class="o_azm_muted" t-out="q.help"/>
                                    <t t-if="q.qtype === 'number'">
                                        <input type="number" class="form-control o_azm_number" min="0"
                                               t-att-value="q.value_number || ''"
                                               t-att-disabled="this.locked(q)"
                                               t-on-change="(ev) => this.setNumber(q, ev)"/>
                                    </t>
                                    <t t-elif="q.qtype === 'select' and this.mainOptions(q).length > 9">
                                        <div class="o_azm_select_row">
                                            <select class="form-select o_azm_select" t-att-disabled="this.locked(q)"
                                                    t-on-change="(ev) => this.pickSelect(q, ev)">
                                                <option value="" t-att-selected="!q.option_id">اختار…</option>
                                                <t t-foreach="this.mainOptions(q)" t-as="opt" t-key="opt.id">
                                                    <option t-att-value="opt.id" t-att-selected="q.option_id === opt.id" t-out="opt.name"/>
                                                </t>
                                            </select>
                                            <t t-foreach="this.fallbackOptions(q)" t-as="opt" t-key="opt.id">
                                                <button type="button" t-attf-class="o_azm_chip o_azm_chip_soft {{this.isChosen(q, opt) ? 'o_azm_chip_on' : ''}}"
                                                        t-att-disabled="this.locked(q)"
                                                        t-on-click="() => this.pick(q, opt)"
                                                        t-out="opt.name"/>
                                            </t>
                                        </div>
                                    </t>
                                    <t t-else="">
                                        <div class="o_azm_chips">
                                            <t t-foreach="this.mainOptions(q)" t-as="opt" t-key="opt.id">
                                                <button type="button" t-attf-class="o_azm_chip {{this.isChosen(q, opt) ? 'o_azm_chip_on' : ''}} {{q.qtype === 'multi' ? 'o_azm_chip_multi' : ''}}"
                                                        t-att-disabled="this.locked(q)"
                                                        t-on-click="() => this.pick(q, opt)"
                                                        t-out="opt.name"/>
                                            </t>
                                            <t t-foreach="this.fallbackOptions(q)" t-as="opt" t-key="opt.id">
                                                <button type="button" t-attf-class="o_azm_chip o_azm_chip_soft {{this.isChosen(q, opt) ? 'o_azm_chip_on' : ''}}"
                                                        t-att-disabled="this.locked(q)"
                                                        t-on-click="() => this.pick(q, opt)"
                                                        t-out="opt.name"/>
                                            </t>
                                        </div>
                                    </t>
                                </div>
                            </t>
                        </div>
                    </t>

                    <div class="o_azm_stage_nav">
                        <button type="button" class="btn btn-secondary" t-on-click="() => this.nextStage(-1)">المرحلة السابقة</button>
                        <button type="button" t-attf-class="btn {{this.nextIsSend ? 'btn-success' : 'btn-primary'}}"
                                t-on-click="() => this.onNext()" t-out="this.nextLabel"/>
                    </div>
                </section>

                <!-- live output -->
                <aside class="o_azm_live">
                    <div class="o_azm_live_bar">
                        <span class="o_azm_live_title">المخرجات الحية</span>
                        <div class="btn-group btn-group-sm">
                            <button type="button" t-attf-class="btn {{this.state.scope === 'stage' ? 'btn-primary' : 'btn-secondary'}}"
                                    t-on-click="() => this.setScope('stage')">المرحلة الحالية</button>
                            <button type="button" t-attf-class="btn {{this.state.scope === 'cycle' ? 'btn-primary' : 'btn-secondary'}}"
                                    t-on-click="() => this.setScope('cycle')">الدورة بالكامل</button>
                        </div>
                    </div>
                    <div class="o_azm_tabs">
                        <t t-foreach="d.tabs" t-as="tab" t-key="tab.key">
                            <button type="button" t-attf-class="o_azm_tab {{this.state.tab === tab.key ? 'o_azm_tab_on' : ''}}"
                                    t-on-click="() => this.setTab(tab.key)" t-out="tab.title"/>
                        </t>
                    </div>
                    <div t-attf-class="o_azm_live_doc {{this.state.busy ? 'o_azm_busy' : ''}}">
                        <t t-out="this.state.output"/>
                    </div>
                </aside>
            </div>
        </div>
    </t>

</templates>
