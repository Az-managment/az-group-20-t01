<?xml version="1.0" encoding="UTF-8"?>
<templates xml:space="preserve">

    <t t-name="azm_operating_model.FinWorkspace">
        <div class="o_azm_workspace o_azm_fin_ws" t-if="d">

            <!-- header -->
            <header class="o_azm_ws_header">
                <div>
                    <b t-out="d.header.name"/>
                    <span class="o_azm_muted"> · <t t-out="d.header.entity"/></span>
                    <span t-if="d.header.is_demo" class="o_azm_fin_tag">مثال</span>
                    <span t-if="d.header.readonly" class="o_azm_fin_tag o_na" t-out="d.header.state_label"/>
                </div>
                <div class="o_azm_fin_row">
                    <span class="o_azm_muted">
                        <t t-out="d.header.answered"/> / <t t-out="d.header.questions"/> سؤال
                    </span>
                    <div class="o_azm_progress" t-att-title="d.header.progress + '%'">
                        <span class="o_azm_progress_bar" t-attf-style="width: {{d.header.progress}}%"/>
                    </div>
                    <span t-if="state.saving" class="o_azm_muted">يحفظ…</span>
                </div>
            </header>

            <div class="o_azm_ws_body">

                <!-- modules -->
                <nav class="o_azm_rail">
                    <label class="o_azm_fin_showall">
                        <input type="checkbox" t-att-checked="state.showAll"
                               t-on-change="() => this.toggleShowAll()"/>
                        إظهار غير المنطبق
                    </label>
                    <t t-foreach="d.modules" t-as="mod" t-key="mod.code">
                        <button t-attf-class="o_azm_rail_item {{mod.code === d.module.code ? 'o_azm_active' : ''}}"
                                t-on-click="() => this.selectModule(mod.code)">
                            <span class="o_azm_fin_idx" t-out="mod.code"/>
                            <span class="o_azm_rail_name" t-out="mod.name"/>
                            <span class="o_azm_muted"><t t-out="mod.answered"/>/<t t-out="mod.questions"/></span>
                        </button>
                    </t>
                </nav>

                <!-- topics and their requirements -->
                <section class="o_azm_questions">
                    <t t-if="!d.topics.length">
                        <p class="o_azm_muted">لا توجد متطلبات منطبقة في هذا الموديول.</p>
                    </t>

                    <t t-foreach="d.topics" t-as="topic" t-key="topic.id">
                        <div class="o_azm_group_card">
                            <h4>
                                <t t-out="topic.name"/>
                                <span class="o_azm_code" t-out="topic.code"/>
                            </h4>

                            <!-- opening prompts: reference material, not answered here -->
                            <button t-if="topic.prompts.length" class="btn btn-link btn-sm p-0 o_azm_fin_tabletoggle"
                                    t-on-click="() => this.togglePrompts(topic)">
                                <t t-if="state.openPrompts[topic.id]">▾</t><t t-else="">◂</t>
                                أسئلة افتتاحية (<t t-out="topic.prompts.length"/>)
                            </button>
                            <ul t-if="state.openPrompts[topic.id]" class="o_azm_fin_prompts">
                                <li t-foreach="topic.prompts" t-as="prompt" t-key="prompt.code">
                                    <span class="o_azm_fin_tag" t-out="prompt.axis_name"/>
                                    <t t-out="prompt.question"/>
                                    <span t-if="prompt.output" class="o_azm_muted"> → <t t-out="prompt.output"/></span>
                                </li>
                            </ul>

                            <t t-foreach="topic.requirements" t-as="req" t-key="req.answer_id">
                                <div t-attf-class="o_azm_fin_req {{req.na ? 'o_azm_fin_na_req' : ''}}">

                                    <div class="o_azm_q_head">
                                        <span class="o_azm_q_label" t-out="req.title"/>
                                        <span class="o_azm_code" t-out="req.code"/>
                                    </div>
                                    <p class="o_azm_fin_question" t-out="req.question"/>
                                    <div class="o_azm_fin_tags">
                                        <span class="o_azm_fin_tag" t-out="req.profile_name"/>
                                        <span class="o_azm_fin_tag" t-out="req.scope_name"/>
                                        <span t-if="req.source === 'HRF'" class="o_azm_fin_tag o_hrf">HRF</span>
                                        <span t-if="req.pack" class="o_azm_fin_tag" t-out="req.pack"/>
                                        <span class="o_azm_muted"><t t-out="req.q_answered"/>/<t t-out="req.q_total"/></span>
                                        <div class="o_azm_progress" style="min-width: 70px">
                                            <span class="o_azm_progress_bar"
                                                  t-attf-style="width: {{this.progressOf(req)}}%"/>
                                        </div>
                                    </div>

                                    <!-- «لا ينطبق» closes the requirement instead of answering it -->
                                    <div class="o_azm_fin_row">
                                        <button t-attf-class="o_azm_chip o_azm_chip_soft {{req.na ? 'o_azm_chip_on' : ''}}"
                                                t-att-disabled="d.header.readonly"
                                                t-on-click="() => this.toggleNa(req)">لا ينطبق على الكيان</button>
                                        <t t-if="req.na">
                                            <t t-foreach="d.na_reasons" t-as="reason" t-key="reason">
                                                <button t-attf-class="o_azm_chip {{req.reason === reason ? 'o_azm_chip_on' : ''}}"
                                                        t-att-disabled="d.header.readonly"
                                                        t-on-click="() => this.setReason(req, reason)" t-out="reason"/>
                                            </t>
                                        </t>
                                    </div>

                                    <!-- the questionnaire -->
                                    <t t-if="!req.na">
                                        <t t-foreach="this.questionsOf(req)" t-as="q" t-key="q.id">
                                            <div t-attf-class="o_azm_q o_azm_fin_q_{{q.role}} {{q.answered ? 'o_azm_q_done' : ''}}">
                                                <div class="o_azm_q_head">
                                                    <span class="o_azm_q_label" t-out="q.label"/>
                                                    <span class="o_azm_code" t-out="q.key"/>
                                                </div>
                                                <p t-if="q.hint" class="o_azm_muted o_azm_fin_qhelp" t-out="q.hint"/>

                                                <!-- number -->
                                                <div t-if="q.qtype === 'number'" class="o_azm_select_row">
                                                    <input type="number" class="form-control form-control-sm o_azm_number"
                                                           t-att-value="q.value.number"
                                                           t-att-disabled="d.header.readonly"
                                                           t-on-change="(ev) => this.setNumber(req, q, ev)"/>
                                                    <span class="o_azm_fin_qunit" t-out="q.unit"/>
                                                </div>

                                                <!-- table -->
                                                <t t-elif="q.qtype === 'table' and q.columns.length">
                                                    <div class="o_azm_fin_schema o_azm_fin_tablewrap">
                                                        <table class="table table-sm o_azm_fin_edit">
                                                            <thead>
                                                                <tr>
                                                                    <th t-foreach="q.columns" t-as="col" t-key="col_index"
                                                                        t-att-title="col.options ? col.options.join(' · ') : false">
                                                                        <t t-out="col.label"/><span t-if="col.options" class="o_azm_fin_haslist">▾</span>
                                                                    </th>
                                                                    <th class="o_azm_fin_qtable_act"/>
                                                                </tr>
                                                            </thead>
                                                            <tbody>
                                                                <t t-foreach="this.rows(q)" t-as="row" t-key="row_index">
                                                                    <tr>
                                                                        <td t-foreach="q.columns" t-as="col" t-key="col_index">
                                                                            <select t-if="col.options" class="form-select form-select-sm"
                                                                                    t-att-disabled="d.header.readonly"
                                                                                    t-on-change="(ev) => this.onCell(req, q, row_index, col_index, ev)">
                                                                                <option value="">—</option>
                                                                                <t t-foreach="col.options" t-as="opt" t-key="opt_index">
                                                                                    <option t-att-value="opt" t-att-selected="row[col_index] === opt" t-out="opt"/>
                                                                                </t>
                                                                            </select>
                                                                            <input t-else="" class="form-control form-control-sm"
                                                                                   t-att-type="this.cellType(col)"
                                                                                   t-att-step="col.type === 'number' ? 'any' : false"
                                                                                   t-att-value="row[col_index]" t-att-readonly="d.header.readonly"
                                                                                   t-on-input="(ev) => this.onCell(req, q, row_index, col_index, ev)"/>
                                                                        </td>
                                                                        <td class="o_azm_fin_qtable_act">
                                                                            <button t-if="!d.header.readonly" title="حذف الصف"
                                                                                    class="btn btn-link btn-sm text-danger p-0 o_azm_fin_rowdel"
                                                                                    t-on-click="() => this.removeRow(req, q, row_index)">×</button>
                                                                        </td>
                                                                    </tr>
                                                                </t>
                                                            </tbody>
                                                        </table>
                                                        <button t-if="!d.header.readonly" class="o_azm_fin_addrow"
                                                                t-on-click="() => this.addRow(req, q)">+ إضافة صف</button>
                                                        <!-- a table can still be answered «لا يوجد» -->
                                                        <div t-if="this.fallbackOptions(q).length" class="o_azm_chips">
                                                            <t t-foreach="this.fallbackOptions(q)" t-as="opt" t-key="opt.id">
                                                                <button t-attf-class="o_azm_chip o_azm_chip_soft {{this.isPicked(q, opt) ? 'o_azm_chip_on' : ''}}"
                                                                        t-att-disabled="d.header.readonly"
                                                                        t-on-click="() => this.pick(req, q, opt)" t-out="opt.name"/>
                                                            </t>
                                                        </div>
                                                    </div>
                                                </t>

                                                <!-- a long single-choice list reads better as a dropdown -->
                                                <t t-elif="q.qtype === 'select' and this.mainOptions(q).length > 9">
                                                    <div class="o_azm_select_row">
                                                        <select class="form-select o_azm_select" t-att-disabled="d.header.readonly"
                                                                t-on-change="(ev) => this.pickFromSelect(req, q, ev)">
                                                            <option value="" t-att-selected="!q.value.option_id">اختار…</option>
                                                            <t t-foreach="this.mainOptions(q)" t-as="opt" t-key="opt.id">
                                                                <option t-att-value="opt.id" t-att-selected="q.value.option_id === opt.id" t-out="opt.name"/>
                                                            </t>
                                                        </select>
                                                        <t t-foreach="this.fallbackOptions(q)" t-as="opt" t-key="opt.id">
                                                            <button t-attf-class="o_azm_chip o_azm_chip_soft {{this.isPicked(q, opt) ? 'o_azm_chip_on' : ''}}"
                                                                    t-att-disabled="d.header.readonly"
                                                                    t-on-click="() => this.pick(req, q, opt)" t-out="opt.name"/>
                                                        </t>
                                                    </div>
                                                </t>

                                                <!-- chips -->
                                                <t t-else="">
                                                    <div class="o_azm_chips">
                                                        <t t-foreach="this.mainOptions(q)" t-as="opt" t-key="opt.id">
                                                            <button t-attf-class="o_azm_chip {{this.isPicked(q, opt) ? 'o_azm_chip_on' : ''}} {{q.qtype === 'multi' ? 'o_azm_chip_multi' : ''}}"
                                                                    t-att-disabled="d.header.readonly"
                                                                    t-on-click="() => this.pick(req, q, opt)" t-out="opt.name"/>
                                                        </t>
                                                        <t t-foreach="this.fallbackOptions(q)" t-as="opt" t-key="opt.id">
                                                            <button t-attf-class="o_azm_chip o_azm_chip_soft {{this.isPicked(q, opt) ? 'o_azm_chip_on' : ''}}"
                                                                    t-att-disabled="d.header.readonly"
                                                                    t-on-click="() => this.pick(req, q, opt)" t-out="opt.name"/>
                                                        </t>
                                                    </div>
                                                </t>

                                                <!-- the note that goes with the question, answered from a list -->
                                                <div t-if="q.note_label" class="o_azm_fin_note">
                                                    <span class="o_azm_fin_label" t-out="q.note_label"/>
                                                    <div class="o_azm_chips">
                                                        <t t-foreach="q.note_options" t-as="tag" t-key="tag">
                                                            <button t-attf-class="o_azm_chip {{this.hasTag(q, tag) ? 'o_azm_chip_on' : ''}} o_azm_chip_multi"
                                                                    t-att-disabled="d.header.readonly"
                                                                    t-on-click="() => this.toggleTag(req, q, tag)" t-out="tag"/>
                                                        </t>
                                                    </div>
                                                    <textarea t-if="this.wantsFreeText(q)" class="form-control" rows="2"
                                                              t-att-value="q.value.note" t-att-readonly="d.header.readonly"
                                                              placeholder="اكتب التفاصيل…"
                                                              t-on-input="(ev) => this.onNote(req, q, ev)"/>
                                                    <div t-if="q.has_priority" class="o_azm_fin_row">
                                                        <span class="o_azm_fin_label">الأولوية</span>
                                                        <t t-foreach="d.priorities" t-as="prio" t-key="prio.key">
                                                            <button t-attf-class="o_azm_chip {{q.value.priority === prio.key ? 'o_azm_chip_on' : ''}}"
                                                                    t-att-disabled="d.header.readonly"
                                                                    t-on-click="() => this.setPriority(req, q, prio.key)" t-out="prio.name"/>
                                                        </t>
                                                    </div>
                                                </div>
                                            </div>
                                        </t>
                                    </t>
                                </div>
                            </t>
                        </div>
                    </t>
                </section>

                <!-- live output -->
                <aside class="o_azm_live">
                    <div class="o_azm_live_bar">
                        <span class="o_azm_live_title">المخرجات الحية</span>
                        <div class="o_azm_fin_row">
                            <button t-attf-class="o_azm_chip {{state.scope === 'module' ? 'o_azm_chip_on' : ''}}"
                                    t-on-click="() => this.setScope('module')">الموديول</button>
                            <button t-attf-class="o_azm_chip {{state.scope === 'model' ? 'o_azm_chip_on' : ''}}"
                                    t-on-click="() => this.setScope('model')">النموذج</button>
                        </div>
                    </div>
                    <div class="o_azm_tabs">
                        <t t-foreach="d.tabs" t-as="tab" t-key="tab.key">
                            <button t-attf-class="o_azm_tab {{state.tab === tab.key ? 'o_azm_tab_on' : ''}}"
                                    t-on-click="() => this.selectTab(tab.key)" t-out="tab.title"/>
                        </t>
                    </div>
                    <div t-attf-class="o_azm_live_doc {{state.busy ? 'o_azm_busy' : ''}}" t-out="state.output"/>
                </aside>
            </div>
        </div>
    </t>

</templates>
