<?xml version="1.0" encoding="UTF-8"?>
<templates xml:space="preserve">

    <!-- one question: same widgets as the procurement workspace -->
    <t t-name="azm_operating_model.FinQuestion">
        <div t-attf-class="o_azm_q o_azm_fin_role_{{q.role}} {{q.answered ? 'o_azm_q_done' : ''}}">
            <div class="o_azm_q_head">
                <span class="o_azm_q_label" t-out="q.label"/>
                <span class="o_azm_code" t-att-title="q.condition_text" t-out="r.code + '/' + q.key"/>
            </div>
            <p t-if="q.hint" class="o_azm_fin_hint" t-out="q.hint"/>

            <!-- number -->
            <t t-if="q.qtype === 'number'">
                <div class="o_azm_select_row">
                    <input type="number" class="form-control o_azm_number" min="0" step="any"
                           t-att-value="q.value.number === null ? '' : q.value.number"
                           t-att-disabled="d.header.readonly"
                           t-on-input="(ev) => this.setNumber(r, q, ev)"/>
                    <span t-if="q.unit" class="o_azm_fin_unit" t-out="q.unit"/>
                </div>
            </t>

            <!-- table -->
            <t t-elif="q.qtype === 'table'">
                <t t-set="rows" t-value="this.rows(q)"/>
                <div class="o_azm_fin_tablewrap">
                    <table class="o_azm_table o_azm_fin_edit">
                        <thead><tr>
                            <t t-foreach="q.columns" t-as="col" t-key="col_index"><th t-out="col.label"/></t>
                            <th t-if="!d.header.readonly"/>
                        </tr></thead>
                        <tbody>
                            <tr t-foreach="rows" t-as="row" t-key="row_index">
                                <t t-foreach="q.columns" t-as="col" t-key="col_index">
                                    <td>
                                        <select t-if="col.options" class="form-select form-select-sm" t-att-disabled="d.header.readonly"
                                                t-on-change="(ev) => this.onCell(r, q, row_index, col_index, ev)">
                                            <option value="">—</option>
                                            <t t-foreach="col.options" t-as="opt" t-key="opt_index">
                                                <option t-att-value="opt" t-att-selected="row[col_index] === opt" t-out="opt"/>
                                            </t>
                                        </select>
                                        <input t-else="" t-att-type="col.type === 'number' ? 'number' : col.type === 'date' ? 'date' : 'text'"
                                               class="form-control form-control-sm" t-att-readonly="d.header.readonly" min="0" step="any"
                                               t-att-value="row[col_index]" t-on-input="(ev) => this.onCell(r, q, row_index, col_index, ev)"/>
                                    </td>
                                </t>
                                <td t-if="!d.header.readonly">
                                    <button t-if="rows.length > 1" class="btn btn-link btn-sm text-danger p-0" title="حذف الصف"
                                            t-on-click="() => this.removeRow(r, q, row_index)">×</button>
                                </td>
                            </tr>
                        </tbody>
                    </table>
                </div>
                <div class="o_azm_select_row">
                    <button t-if="!d.header.readonly" class="btn btn-secondary btn-sm" t-on-click="() => this.addRow(r, q)">+ إضافة صف</button>
                    <t t-foreach="this.fallbackOptions(q)" t-as="opt" t-key="opt.id">
                        <button t-attf-class="o_azm_chip o_azm_chip_soft {{this.isChosen(q, opt) ? 'o_azm_chip_on' : ''}}"
                                t-att-disabled="d.header.readonly" t-on-click="() => this.pick(r, q, opt)" t-out="opt.name"/>
                    </t>
                </div>
            </t>

            <!-- long single choice: dropdown + fallback chips -->
            <t t-elif="q.qtype === 'select' and this.mainOptions(q).length > 9">
                <div class="o_azm_select_row">
                    <select class="form-select o_azm_select" t-att-disabled="d.header.readonly"
                            t-on-change="(ev) => this.pickSelect(r, q, ev)">
                        <option value="" t-att-selected="!q.value.option_id or !this.mainOptions(q).some((o) => o.id === q.value.option_id)">اختار…</option>
                        <t t-foreach="this.mainOptions(q)" t-as="opt" t-key="opt.id">
                            <option t-att-value="opt.id" t-att-selected="q.value.option_id === opt.id" t-out="opt.name"/>
                        </t>
                    </select>
                    <t t-foreach="this.fallbackOptions(q)" t-as="opt" t-key="opt.id">
                        <button t-attf-class="o_azm_chip o_azm_chip_soft {{this.isChosen(q, opt) ? 'o_azm_chip_on' : ''}}"
                                t-att-disabled="d.header.readonly" t-on-click="() => this.pick(r, q, opt)" t-out="opt.name"/>
                    </t>
                </div>
            </t>

            <!-- chips (single / multiple) -->
            <t t-else="">
                <div class="o_azm_chips">
                    <t t-foreach="this.mainOptions(q)" t-as="opt" t-key="opt.id">
                        <button t-attf-class="o_azm_chip {{this.isChosen(q, opt) ? 'o_azm_chip_on' : ''}} {{q.qtype === 'multi' ? 'o_azm_chip_multi' : ''}} {{q.role === 'status' ? 'o_azm_fin_status_chip' : ''}}"
                                t-att-disabled="d.header.readonly" t-on-click="() => this.pick(r, q, opt)" t-out="opt.name"/>
                    </t>
                    <t t-foreach="this.fallbackOptions(q)" t-as="opt" t-key="opt.id">
                        <button t-attf-class="o_azm_chip o_azm_chip_soft {{this.isChosen(q, opt) ? 'o_azm_chip_on' : ''}}"
                                t-att-disabled="d.header.readonly" t-on-click="() => this.pick(r, q, opt)" t-out="opt.name"/>
                    </t>
                </div>
            </t>

            <!-- the text box of the question, answered from a list -->
            <div t-if="q.note_label" class="o_azm_fin_notebox">
                <span class="o_azm_fin_label" t-out="q.note_label"/>
                <div t-if="q.note_options.length" class="o_azm_chips">
                    <t t-foreach="q.note_options" t-as="tag" t-key="tag">
                        <button t-attf-class="o_azm_chip o_azm_chip_multi {{tag === 'أخرى' ? 'o_azm_chip_soft' : ''}} {{q.value.note_tags.includes(tag) ? 'o_azm_chip_on' : ''}}"
                                t-att-disabled="d.header.readonly" t-on-click="() => this.toggleTag(r, q, tag)" t-out="tag"/>
                    </t>
                </div>
                <div t-if="q.has_priority" class="o_azm_select_row">
                    <span class="o_azm_muted">الأولوية</span>
                    <t t-foreach="d.priorities" t-as="p" t-key="p.key">
                        <button t-attf-class="o_azm_chip {{q.value.priority === p.key ? 'o_azm_chip_on' : ''}}"
                                t-att-disabled="d.header.readonly" t-on-click="() => this.setPriority(r, q, p.key)" t-out="p.name"/>
                    </t>
                </div>
                <textarea t-if="!q.note_options.length or q.value.note_tags.includes('أخرى') or q.value.note"
                          class="form-control" rows="2" t-att-value="q.value.note" t-att-readonly="d.header.readonly"
                          placeholder="اكتب التفاصيل…" t-on-input="(ev) => this.setNote(r, q, ev)"/>
            </div>
        </div>
    </t>

    <t t-name="azm_operating_model.FinWorkspace">
        <div class="o_azm_workspace o_azm_fin_ws" dir="rtl" t-if="this.state.data">
            <t t-set="d" t-value="this.state.data"/>

            <!-- header (same as the procurement workspace) -->
            <header class="o_azm_ws_header">
                <div class="o_azm_ws_title">
                    <span class="o_azm_ws_eyebrow">AZM · Unified Financial Model</span>
                    <h2>
                        <t t-out="d.header.entity"/>
                        <small> · النموذج المالي الموحد · <t t-out="d.header.scopes.map((s) => s.name).join('، ')"/></small>
                    </h2>
                </div>
                <div class="o_azm_ws_meta">
                    <span t-attf-class="o_azm_pill o_azm_state_{{d.header.state}}" t-out="d.header.state_label"/>
                    <span t-if="d.header.is_demo" class="o_azm_pill o_azm_state_demo">مثال افتراضي</span>
                    <span class="o_azm_pill">v<t t-out="d.header.version"/></span>
                    <span class="o_azm_pill o_azm_fin_counter" title="مطبّق بالكامل / جزئيًا / غير منفذ / لا أعرف / لا ينطبق">
                        <i class="o_full"/><t t-out="d.header.counts.full"/>
                        <i class="o_partial"/><t t-out="d.header.counts.partial"/>
                        <i class="o_unavailable"/><t t-out="d.header.counts.unavailable"/>
                        <i class="o_unknown"/><t t-out="d.header.counts.unknown"/>
                        <i class="o_na"/><t t-out="d.header.counts.na"/>
                    </span>
                    <div class="o_azm_progress" t-att-title="d.header.progress + '%'">
                        <div t-attf-style="width: {{d.header.progress}}%"/>
                    </div>
                    <span class="o_azm_muted"><t t-out="d.header.answered"/>/<t t-out="d.header.questions"/> سؤال · <t t-out="d.header.progress"/>٪</span>
                    <span t-if="this.state.saving" class="o_azm_muted">يحفظ…</span>
                    <!-- the preparer asks for it to be looked at -->
                    <button t-if="d.header.can_send" class="btn btn-primary btn-sm"
                            t-att-disabled="this.state.busy"
                            t-on-click="() => this.requestReview()">
                        اطلب المراجعة <em class="o_azm_en">Request review</em>
                    </button>
                    <!-- and the reviewer sends a part of it back -->
                    <button t-if="d.header.can_return" class="btn btn-outline-warning btn-sm"
                            t-att-disabled="this.state.busy"
                            t-on-click="() => this.startReturn('module', d.module.id, d.module.name)">
                        أعد هذا الموديول <em class="o_azm_en">Send this module back</em>
                    </button>
                    <button class="btn btn-secondary btn-sm" t-on-click="() => this.openRecord()">
                        <t t-out="d.header.name"/>
                    </button>
                </div>
            </header>

            <!-- why a part came back, read beside the questions rather than remembered
                 from another page -->
            <div t-if="d.header.returns.length" class="o_azm_ws_returns">
                <div t-foreach="d.header.returns" t-as="item" t-key="item.id" class="o_azm_ws_return">
                    <i class="oi" data-icon="undo" title="عاد"/>
                    <div>
                        <b><t t-out="item.part"/></b>
                        <p t-out="item.note"/>
                        <small>أعادها <t t-out="item.reviewer"/></small>
                    </div>
                </div>
            </div>

            <!-- the reviewer's note, written where the work is -->
            <div t-if="this.state.returning" class="o_azm_ws_compose">
                <label>
                    سبب الإعادة — <b t-out="this.state.returning.name"/>
                    <em class="o_azm_en">Why it is coming back</em>
                </label>
                <textarea class="form-control" rows="3" placeholder="ما الذي يحتاج معالجة؟"
                          t-att-value="this.state.returnNote"
                          t-on-input="(ev) => this.state.returnNote = ev.target.value"/>
                <div class="o_azm_ws_compose_actions">
                    <button class="btn btn-sm btn-light" t-on-click="() => this.cancelReturn()">
                        تراجع
                    </button>
                    <button class="btn btn-sm btn-warning"
                            t-att-disabled="this.state.busy or !this.state.returnNote.trim()"
                            t-on-click="() => this.confirmReturn()">
                        أعدها مع الملاحظة
                    </button>
                </div>
            </div>

            <div class="o_azm_ws_body">
                <!-- module rail -->
                <nav class="o_azm_rail">
                    <label class="o_azm_fin_showall">
                        <input type="checkbox" t-att-checked="this.state.showAll" t-on-change="() => this.toggleShowAll()"/>
                        إظهار غير المنطبق على الكيان
                    </label>
                    <label class="o_azm_fin_showall">
                        <input type="checkbox" t-att-checked="this.state.onlyOpen" t-on-change="() => this.toggleOnlyOpen()"/>
                        غير المكتمل فقط
                    </label>
                    <t t-foreach="d.modules" t-as="mod" t-key="mod.code">
                        <button t-attf-class="o_azm_rail_item o_azm_status_{{this.moduleStatus(mod)}} {{mod.code === this.state.moduleCode ? 'o_azm_active' : ''}}"
                                t-on-click="() => this.selectModule(mod)">
                            <span class="o_azm_rail_idx o_azm_fin_idx" t-out="mod.code"/>
                            <span class="o_azm_rail_text">
                                <span class="o_azm_rail_name" t-out="mod.name"/>
                                <span class="o_azm_rail_sub">
                                    <t t-out="mod.answered"/>/<t t-out="mod.questions"/> إجابة
                                    <span t-if="mod.gaps" class="o_azm_risk_dot" t-att-title="mod.gaps + ' فجوة'" t-out="mod.gaps"/>
                                </span>
                                <span class="o_azm_rail_bar"><span t-attf-style="width: {{this.modulePercent(mod)}}%"/></span>
                            </span>
                        </button>
                    </t>
                </nav>

                <!-- topics · requirements · questions -->
                <section class="o_azm_questions">
                    <div class="o_azm_stage_intro">
                        <span class="o_azm_code">FIN.<t t-out="d.module.code"/></span>
                        <h3 t-out="d.module.name"/>
                        <p class="o_azm_muted">
                            <t t-out="this.requirements().length"/> متطلب منطبق من <t t-out="d.module.total"/> ·
                            لكل متطلب أسئلته الخاصة (اختيار، متعدد، رقم، جدول) ثم الوضع الحالي ووسيلة التنفيذ وحالة القاعدة والتوجه المستهدف.
                        </p>
                        <div t-if="d.header.readonly" class="o_azm_note o_azm_note_warn">
                            الإفادة في حالة «<t t-out="d.header.state_label"/>» — للقراءة فقط.
                        </div>
                        <div t-if="!d.topics.length" class="o_azm_note">
                            لا توجد متطلبات منطبقة على أنشطة هذا الكيان في هذا الموديول.
                        </div>
                    </div>

                    <t t-foreach="this.visibleTopics()" t-as="topic" t-key="topic.id">
                        <div class="o_azm_fin_topicline">
                            <span class="o_azm_code" t-out="topic.code"/>
                            <span class="o_azm_fin_topicname" t-out="topic.name"/>
                            <button t-if="topic.prompts.length" class="btn btn-link btn-sm p-0 o_azm_fin_prompts_toggle"
                                    t-on-click="() => this.togglePrompts(topic)">
                                أسئلة افتتاحية مقترحة (<t t-out="topic.prompts.length"/>)
                            </button>
                        </div>
                        <ol t-if="this.state.openPrompts[topic.id]" class="o_azm_fin_advlist">
                            <li t-foreach="topic.prompts" t-as="p" t-key="p.code">
                                <span class="o_azm_code" t-out="p.axis"/> <b t-out="p.question"/>
                                <div class="o_azm_muted">
                                    <t t-out="p.axis_name"/> · المخرج: <t t-out="p.output"/>
                                    <t t-if="p.stage === 'design'"> · تصميم لاحق</t>
                                </div>
                            </li>
                        </ol>

                        <t t-foreach="this.topicRequirements(topic)" t-as="r" t-key="r.answer_id">
                            <div t-att-data-req="r.code" t-attf-class="o_azm_group_card o_azm_fin_card {{r.applicable ? '' : 'o_azm_fin_na_req'}}">
                                <div class="o_azm_fin_card_head">
                                    <h4 t-out="r.title"/>
                                    <span t-if="r.state" t-attf-class="o_azm_fin_statepill o_azm_fin_s_{{r.state}}" t-out="this.stateLabel(r)"/>
                                    <span class="o_azm_fin_count" t-if="!r.na"><t t-out="r.q_answered"/>/<t t-out="r.q_total"/> إجابة</span>
                                    <button t-attf-class="o_azm_chip o_azm_chip_soft o_azm_fin_na_chip {{r.na ? 'o_azm_chip_on' : ''}}"
                                            t-att-disabled="d.header.readonly" t-on-click="() => this.toggleNa(r)">لا ينطبق</button>
                                    <!-- one requirement back, rather than the module it sits in -->
                                    <button t-if="d.header.can_return" class="o_azm_chip o_azm_chip_soft o_azm_fin_return_chip"
                                            title="أعد هذا المتطلب مع ملاحظة"
                                            t-on-click="() => this.startReturn('requirement', r.requirement_id, r.title)">
                                        <i class="oi" data-icon="undo" title="أعد"/> أعده
                                    </button>
                                </div>
                                <p class="o_azm_fin_meta">
                                    <span class="o_azm_code" t-out="r.code"/>
                                    <t t-out="[r.req_id, r.response_type, r.scope_name, r.owner].filter((x) => x).join(' · ')"/>
                                    <span t-if="r.source === 'HRF'" class="o_azm_fin_hrf"> · مالية الموارد البشرية</span>
                                    <span t-if="!r.applicable" class="o_azm_fin_bad"> · غير منطبق على الكيان</span>
                                </p>

                                <div t-if="r.na" class="o_azm_fin_notebox">
                                    <span class="o_azm_fin_label">سبب عدم الانطباق <b>*</b></span>
                                    <div class="o_azm_chips">
                                        <t t-foreach="d.na_reasons" t-as="reason" t-key="reason">
                                            <button t-attf-class="o_azm_chip {{this.reasonChoice(r) === reason ? 'o_azm_chip_on' : ''}}"
                                                    t-att-disabled="d.header.readonly" t-on-click="() => this.pickReason(r, reason)" t-out="reason"/>
                                        </t>
                                    </div>
                                    <textarea t-if="this.reasonChoice(r) === 'سبب آخر'" class="form-control" rows="2"
                                              t-att-value="this.reasonDetail(r)" t-att-readonly="d.header.readonly"
                                              placeholder="اذكر السبب…" t-on-input="(ev) => this.setReason(r, ev)"/>
                                </div>
                                <t t-else="">
                                    <t t-foreach="this.specific(r)" t-as="q" t-key="q.id">
                                        <t t-call="azm_operating_model.FinQuestion"/>
                                    </t>
                                    <h5 class="o_azm_fin_subhead">الوضع الحالي والتوجه</h5>
                                    <t t-foreach="this.unified(r)" t-as="q" t-key="q.id">
                                        <t t-call="azm_operating_model.FinQuestion"/>
                                    </t>
                                    <div class="o_azm_fin_req_foot">
                                        <span t-if="this.hiddenCount(r)" class="o_azm_muted">
                                            <t t-out="this.hiddenCount(r)"/> سؤال يظهر حسب الإجابة
                                        </span>
                                        <button class="btn btn-link btn-sm p-0 o_azm_fin_evidence" t-on-click="() => this.openEvidence(r)">
                                            📎 المصدر والدليل<t t-if="r.attachments"> (<t t-out="r.attachments"/>)</t>
                                        </button>
                                    </div>
                                </t>
                            </div>
                        </t>
                    </t>

                    <div class="o_azm_stage_nav">
                        <button class="btn btn-secondary" t-on-click="() => this.nextModule(-1)">الموديول السابق</button>
                        <button t-attf-class="btn {{this.nextIsSend ? 'btn-success' : 'btn-primary'}}"
                                t-on-click="() => this.onNext()" t-out="this.nextLabel"/>
                    </div>
                </section>

                <!-- live output -->
                <aside class="o_azm_live">
                    <div class="o_azm_live_bar">
                        <span class="o_azm_live_title">المخرجات الحية</span>
                        <div class="btn-group btn-group-sm">
                            <button t-attf-class="btn {{this.state.scope === 'module' ? 'btn-primary' : 'btn-secondary'}}"
                                    t-on-click="() => this.setScope('module')">الموديول الحالي</button>
                            <button t-attf-class="btn {{this.state.scope === 'model' ? 'btn-primary' : 'btn-secondary'}}"
                                    t-on-click="() => this.setScope('model')">النموذج بالكامل</button>
                        </div>
                    </div>
                    <div class="o_azm_tabs">
                        <t t-foreach="d.tabs" t-as="tab" t-key="tab.key">
                            <button t-attf-class="o_azm_tab {{this.state.tab === tab.key ? 'o_azm_tab_on' : ''}}"
                                    t-on-click="() => this.setTab(tab.key)" t-out="tab.title"/>
                        </t>
                    </div>
                    <div t-attf-class="o_azm_live_doc {{this.state.busy ? 'o_azm_busy' : ''}}">
                        <t t-out="this.state.output"/>
                    </div>
                </aside>
            </div>
        </div>
    </t>

</templates>
