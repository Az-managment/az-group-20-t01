<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">
        <record id="azm_privilege" model="res.groups.privilege">
            <field name="name">AZM نموذج التشغيل</field>
            <field name="sequence">40</field>
            <field name="category_id" ref="base.module_category_productivity"/>
        </record>

        <record id="azm_group_user" model="res.groups">
            <field name="name">مُعد إفادات</field>
            <field name="sequence">10</field>
            <field name="privilege_id" ref="azm_privilege"/>
            <field name="implied_ids" eval="[(4, ref('base.group_user'))]"/>
        </record>

        <record id="azm_group_reviewer" model="res.groups">
            <field name="name">مراجع</field>
            <field name="sequence">20</field>
            <field name="privilege_id" ref="azm_privilege"/>
            <field name="implied_ids" eval="[(4, ref('azm_group_user'))]"/>
        </record>

        <record id="azm_group_manager" model="res.groups">
            <field name="name">مدير النموذج</field>
            <field name="sequence">30</field>
            <field name="privilege_id" ref="azm_privilege"/>
            <field name="implied_ids" eval="[(4, ref('azm_group_reviewer'))]"/>
            <field name="user_ids" eval="[(4, ref('base.user_root')), (4, ref('base.user_admin'))]"/>
        </record>
    </data>
</odoo>
