<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="azm_assessment_view_list" model="ir.ui.view">
        <field name="name">azm.assessment.view.list</field>
        <field name="model">azm.assessment</field>
        <field name="arch" type="xml">
            <list string="الإفادات">
                <field name="name"/>
                <field name="entity_id"/>
                <field name="purchase_kind"/>
                <field name="scenario"/>
                <field name="version"/>
                <field name="progress" widget="progressbar"/>
                <field name="risk_count" string="مؤشرات خطر"/>
                <field name="user_id" widget="many2one_avatar_user" optional="show"/>
                <field name="state" widget="badge" decoration-info="state == 'draft'"
                       decoration-warning="state == 'review'" decoration-success="state == 'approved'"/>
            </list>
        </field>
    </record>

    <record id="azm_assessment_view_kanban" model="ir.ui.view">
        <field name="name">azm.assessment.view.kanban</field>
        <field name="model">azm.assessment</field>
        <field name="arch" type="xml">
            <kanban default_group_by="entity_id" class="o_azm_assessment_kanban">
                <templates>
                    <t t-name="card">
                        <div class="d-flex justify-content-between">
                            <field name="name" class="fw-bold"/>
                            <field name="state" widget="badge"/>
                        </div>
                        <div class="small text-muted">
                            <field name="purchase_kind"/> · <field name="scenario"/> · v<field name="version"/>
                        </div>
                        <field name="progress" widget="progressbar"/>
                        <footer>
                            <span class="small"><field name="risk_count"/> مؤشر خطر</span>
                            <field name="user_id" widget="many2one_avatar_user" class="ms-auto"/>
                        </footer>
                    </t>
                </templates>
            </kanban>
        </field>
    </record>

    <record id="azm_assessment_view_form" model="ir.ui.view">
        <field name="name">azm.assessment.view.form</field>
        <field name="model">azm.assessment</field>
        <field name="arch" type="xml">
            <form string="إفادة">
                <header>
                    <button name="action_open_workspace" type="object" string="افتح مساحة الإجابة"
                            class="btn-primary" icon="edit_note"/>
                    <button name="action_submit" type="object" string="إرسال للمراجعة"
                            invisible="state != 'draft'"/>
                    <button name="action_approve" type="object" string="اعتماد" class="btn-primary"
                            invisible="state != 'review'" groups="azm_operating_model.azm_group_manager"/>
                    <button name="action_back_to_draft" type="object" string="إرجاع للمسودة"
                            invisible="state != 'review'" groups="azm_operating_model.azm_group_reviewer"/>
                    <button name="action_new_version" type="object" string="إصدار جديد"
                            invisible="state != 'approved'" groups="azm_operating_model.azm_group_manager"/>
                    <button name="action_print_book" type="object" string="طباعة كتاب الدورة" icon="print"/>
                    <field name="state" widget="statusbar" statusbar_visible="draft,review,approved"/>
                </header>
                <sheet>
                    <div class="oe_button_box" name="button_box">
                        <button name="action_view_findings" type="object" class="oe_stat_button" icon="warning">
                            <field name="finding_count" string="سجل المخاطر" widget="statinfo"/>
                        </button>
                        <button name="action_view_answers" type="object" class="oe_stat_button" icon="checklist">
                            <field name="known_count" string="إجابة محددة" widget="statinfo"/>
                        </button>
                    </div>
                    <widget name="web_ribbon" title="مثال" bg_color="text-bg-warning" invisible="not is_demo"/>
                    <div class="oe_title">
                        <field name="name" class="text-muted"/>
                        <h1><field name="entity_id" placeholder="الكيان" readonly="state != 'draft'"/></h1>
                    </div>
                    <group>
                        <group>
                            <field name="purchase_kind" readonly="state != 'draft'"/>
                            <field name="scenario" readonly="state != 'draft'"/>
                            <field name="version"/>
                            <field name="company_id" groups="base.group_multi_company"/>
                        </group>
                        <group>
                            <field name="user_id" widget="many2one_avatar_user"/>
                            <field name="reviewer_id" widget="many2one_avatar_user"/>
                            <field name="progress" widget="progressbar"/>
                            <field name="risk_count" string="مؤشرات خطر"/>
                            <field name="approved_by_id" invisible="not approved_by_id"/>
                            <field name="approved_date" invisible="not approved_date"/>
                            <field name="previous_id" invisible="not previous_id"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="خريطة الدورة" name="map">
                            <field name="output_map_html" readonly="1" nolabel="1"/>
                        </page>
                        <page string="الوضع الحالي" name="book">
                            <field name="output_html" readonly="1" nolabel="1"/>
                        </page>
                        <page string="الإصدارات المعتمدة" name="versions">
                            <field name="version_ids" readonly="1">
                                <list>
                                    <field name="version"/>
                                    <field name="approved_date"/>
                                    <field name="approved_by_id"/>
                                </list>
                                <form>
                                    <group>
                                        <field name="version"/>
                                        <field name="approved_date"/>
                                        <field name="approved_by_id"/>
                                    </group>
                                    <field name="snapshot_html"/>
                                </form>
                            </field>
                        </page>
                        <page string="أدوات" name="tools" invisible="state != 'draft'">
                            <div class="d-flex gap-2">
                                <button name="action_fill_demo" type="object" string="املأ مثالًا افتراضيًا"
                                        class="btn-secondary"
                                        confirm="هيتم ملء الأسئلة الفاضية بإجابات تجريبية فيها ممارسات ضعيفة عمدًا. تكمل؟"/>
                                <button name="action_sync_findings" type="object" string="تحديث سجل المخاطر"
                                        class="btn-secondary"/>
                                <button name="action_reset_answers" type="object" string="مسح كل الإجابات"
                                        class="btn-secondary" confirm="هيتم مسح كل الإجابات. تكمل؟"/>
                            </div>
                        </page>
                    </notebook>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <record id="azm_answer_view_list" model="ir.ui.view">
        <field name="name">azm.answer.view.list</field>
        <field name="model">azm.answer</field>
        <field name="arch" type="xml">
            <list string="الإجابات" editable="bottom" create="0" delete="0">
                <field name="question_id" column_invisible="True"/>
                <field name="qtype" column_invisible="True"/>
                <field name="code" optional="hide"/>
                <field name="stage_id" optional="hide"/>
                <field name="label"/>
                <field name="option_id" invisible="qtype != 'select'" options="{'no_create': True, 'no_open': True}"/>
                <field name="option_ids" widget="many2many_tags" invisible="qtype != 'multi'" options="{'no_create': True}"/>
                <field name="value_number" invisible="qtype != 'number'"/>
                <field name="is_known" optional="hide"/>
                <field name="note" optional="show"/>
                <field name="attachment_ids" widget="many2many_binary" optional="hide"/>
            </list>
        </field>
    </record>

    <record id="azm_answer_view_search" model="ir.ui.view">
        <field name="name">azm.answer.view.search</field>
        <field name="model">azm.answer</field>
        <field name="arch" type="xml">
            <search>
                <field name="label"/>
                <field name="stage_id"/>
                <filter name="unanswered" string="بدون إجابة" domain="[('has_value', '=', False)]"/>
                <filter name="unknown" string="لا أعرف / غير مدرج" domain="[('has_value', '=', True), ('is_known', '=', False)]"/>
                <group>
                    <filter name="by_stage" string="المرحلة" context="{'group_by': 'stage_id'}"/>
                    <filter name="by_group" string="القسم" context="{'group_by': 'group'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="azm_assessment_view_search" model="ir.ui.view">
        <field name="name">azm.assessment.view.search</field>
        <field name="model">azm.assessment</field>
        <field name="arch" type="xml">
            <search>
                <field name="name"/>
                <field name="entity_id"/>
                <filter name="draft" string="مسودات" domain="[('state', '=', 'draft')]"/>
                <filter name="review" string="تحت المراجعة" domain="[('state', '=', 'review')]"/>
                <filter name="approved" string="معتمدة" domain="[('state', '=', 'approved')]"/>
                <filter name="current" string="الإصدارات الحالية" domain="[('state', '!=', 'archived')]"/>
                <filter name="mine" string="إفاداتي" domain="[('user_id', '=', uid)]"/>
                <group>
                    <filter name="by_entity" string="الكيان" context="{'group_by': 'entity_id'}"/>
                    <filter name="by_kind" string="نوع المشتريات" context="{'group_by': 'purchase_kind'}"/>
                    <filter name="by_state" string="الحالة" context="{'group_by': 'state'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="azm_assessment_action" model="ir.actions.act_window">
        <field name="name">الإفادات</field>
        <field name="res_model">azm.assessment</field>
        <field name="view_mode">kanban,list,form</field>
        <field name="context">{'search_default_current': 1}</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">ابدأ أول إفادة</p>
            <p>اختار الكيان ونوع المشتريات والمسار، وبعدين جاوب على الأسئلة؛ الوثائق والرسم بيتكتبوا لوحدهم.</p>
        </field>
    </record>
</odoo>
