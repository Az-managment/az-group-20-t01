<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="azm_risk_rule_view_list" model="ir.ui.view">
        <field name="name">azm.risk.rule.view.list</field>
        <field name="model">azm.risk.rule</field>
        <field name="arch" type="xml">
            <list string="قواعد المخاطر">
                <field name="code"/>
                <field name="stage_id"/>
                <field name="question_id"/>
                <field name="trigger_option_id"/>
                <field name="fact"/>
                <field name="owner_hint" optional="show"/>
                <field name="active" widget="boolean_toggle"/>
            </list>
        </field>
    </record>

    <record id="azm_risk_rule_view_form" model="ir.ui.view">
        <field name="name">azm.risk.rule.view.form</field>
        <field name="model">azm.risk.rule</field>
        <field name="arch" type="xml">
            <form string="قاعدة خطر">
                <sheet>
                    <group>
                        <group>
                            <field name="code"/>
                            <field name="stage_id"/>
                            <field name="question_id"/>
                            <field name="trigger_option_id"/>
                        </group>
                        <group>
                            <field name="owner_hint"/>
                            <field name="active"/>
                        </group>
                    </group>
                    <group>
                        <field name="fact"/>
                        <field name="risk"/>
                        <field name="control"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="azm_risk_rule_action" model="ir.actions.act_window">
        <field name="name">قواعد المخاطر</field>
        <field name="res_model">azm.risk.rule</field>
        <field name="view_mode">list,form</field>
        <field name="context">{'active_test': False}</field>
    </record>
</odoo>
