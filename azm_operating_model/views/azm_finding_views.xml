<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="azm_finding_view_list" model="ir.ui.view">
        <field name="name">azm.finding.view.list</field>
        <field name="model">azm.finding</field>
        <field name="arch" type="xml">
            <list string="سجل المخاطر" decoration-muted="not triggered or state == 'dismissed'"
                  decoration-success="state == 'closed'" decoration-warning="state == 'treatment'">
                <field name="code"/>
                <field name="entity_id" optional="show"/>
                <field name="stage_id"/>
                <field name="fact"/>
                <field name="score" optional="show"/>
                <field name="user_id" widget="many2one_avatar_user" optional="show"/>
                <field name="due_date" optional="show"/>
                <field name="triggered" optional="hide"/>
                <field name="state" widget="badge" decoration-info="state == 'candidate'"
                       decoration-danger="state == 'confirmed'" decoration-warning="state == 'treatment'"
                       decoration-success="state == 'closed'"/>
            </list>
        </field>
    </record>

    <record id="azm_finding_view_form" model="ir.ui.view">
        <field name="name">azm.finding.view.form</field>
        <field name="model">azm.finding</field>
        <field name="arch" type="xml">
            <form string="ملاحظة خطر">
                <header>
                    <button name="action_confirm" type="object" string="تأكيد الخطر" class="btn-primary"
                            invisible="state != 'candidate'" groups="azm_operating_model.azm_group_reviewer"/>
                    <button name="action_treat" type="object" string="بدء المعالجة" class="btn-primary"
                            invisible="state != 'confirmed'" groups="azm_operating_model.azm_group_reviewer"/>
                    <button name="action_close" type="object" string="إقفال بدليل" class="btn-primary"
                            invisible="state != 'treatment'" groups="azm_operating_model.azm_group_reviewer"/>
                    <button name="action_dismiss" type="object" string="استبعاد"
                            invisible="state in ('closed', 'dismissed')" groups="azm_operating_model.azm_group_reviewer"/>
                    <field name="state" widget="statusbar" statusbar_visible="candidate,confirmed,treatment,closed"/>
                </header>
                <sheet>
                    <div class="alert alert-warning" role="alert" invisible="triggered">
                        القاعدة دي مبقتش منطبقة على الإجابات الحالية؛ راجع قبل الإقفال.
                    </div>
                    <div class="oe_title">
                        <field name="code" class="text-muted"/>
                        <h2><field name="fact"/></h2>
                    </div>
                    <group>
                        <group string="الخطر">
                            <field name="assessment_id"/>
                            <field name="stage_id"/>
                            <field name="risk"/>
                            <field name="control"/>
                            <field name="owner_hint"/>
                        </group>
                        <group string="التقييم والمعالجة">
                            <field name="likelihood"/>
                            <field name="impact"/>
                            <field name="score"/>
                            <field name="user_id" widget="many2one_avatar_user"/>
                            <field name="due_date"/>
                        </group>
                    </group>
                    <group string="دليل الإقفال">
                        <field name="evidence" nolabel="1" colspan="2"/>
                    </group>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <record id="azm_finding_view_search" model="ir.ui.view">
        <field name="name">azm.finding.view.search</field>
        <field name="model">azm.finding</field>
        <field name="arch" type="xml">
            <search>
                <field name="fact"/>
                <field name="code"/>
                <field name="entity_id"/>
                <field name="stage_id"/>
                <filter name="open" string="مفتوحة" domain="[('state', 'not in', ('closed', 'dismissed'))]"/>
                <filter name="triggered" string="ما زالت مفعّلة" domain="[('triggered', '=', True)]"/>
                <filter name="mine" string="معالجاتي" domain="[('user_id', '=', uid)]"/>
                <group>
                    <filter name="by_entity" string="الكيان" context="{'group_by': 'entity_id'}"/>
                    <filter name="by_stage" string="المرحلة" context="{'group_by': 'stage_id'}"/>
                    <filter name="by_state" string="الحالة" context="{'group_by': 'state'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="azm_finding_view_kanban" model="ir.ui.view">
        <field name="name">azm.finding.view.kanban</field>
        <field name="model">azm.finding</field>
        <field name="arch" type="xml">
            <kanban default_group_by="state" class="o_azm_finding_kanban">
                <field name="triggered"/>
                <templates>
                    <t t-name="card">
                        <field name="code" class="text-muted small"/>
                        <field name="fact" class="fw-bold"/>
                        <field name="stage_id" class="small"/>
                        <footer>
                            <field name="due_date"/>
                            <field name="user_id" widget="many2one_avatar_user" class="ms-auto"/>
                        </footer>
                    </t>
                </templates>
            </kanban>
        </field>
    </record>

    <record id="azm_finding_action" model="ir.actions.act_window">
        <field name="name">سجل المخاطر</field>
        <field name="res_model">azm.finding</field>
        <field name="view_mode">kanban,list,form</field>
        <field name="context">{'search_default_open': 1}</field>
    </record>
</odoo>
