<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="azm_entity_view_list" model="ir.ui.view">
        <field name="name">azm.entity.view.list</field>
        <field name="model">azm.entity</field>
        <field name="arch" type="xml">
            <list string="الكيانات" editable="bottom" create="0" delete="0">
                <header>
                    <button name="action_sync_companies" type="object" string="مزامنة مع الشركات" display="always"
                            groups="azm_operating_model.azm_group_manager"/>
                </header>
                <field name="sequence" widget="handle"/>
                <field name="code"/>
                <field name="name" readonly="company_id"/>
                <field name="company_id" readonly="1"/>
                <field name="user_ids" widget="many2many_avatar_user" string="المستخدمون المصرح لهم"/>
                <field name="assessment_count" string="الإفادات"/>
                <field name="active" column_invisible="True"/>
            </list>
        </field>
    </record>

    <record id="azm_entity_action" model="ir.actions.act_window">
        <field name="name">الكيانات</field>
        <field name="res_model">azm.entity</field>
        <field name="view_mode">list</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">الكيانات هي شركات Odoo</p>
            <p>كل شركة في النظام لها كيان تلقائيًا؛ أضف الشركة من الإعدادات › الشركات وستظهر هنا.</p>
        </field>
    </record>
</odoo>
