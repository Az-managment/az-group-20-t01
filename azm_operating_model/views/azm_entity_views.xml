<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="azm_entity_view_list" model="ir.ui.view">
        <field name="name">azm.entity.view.list</field>
        <field name="model">azm.entity</field>
        <field name="arch" type="xml">
            <list string="الكيانات" editable="bottom">
                <field name="sequence" widget="handle"/>
                <field name="code"/>
                <field name="name"/>
                <field name="company_id" groups="base.group_multi_company"/>
                <field name="user_ids" widget="many2many_avatar_user" string="المستخدمون المصرح لهم"/>
                <field name="assessment_count" string="الإفادات"/>
                <field name="active" column_invisible="True"/>
            </list>
        </field>
    </record>

    <record id="azm_entity_action" model="ir.actions.act_window">
        <field name="name">الكيانات</field>
        <field name="res_model">azm.entity</field>
        <field name="view_mode">list</field>
    </record>
</odoo>
