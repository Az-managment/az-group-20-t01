<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="azm_question_view_list" model="ir.ui.view">
        <field name="name">azm.question.view.list</field>
        <field name="model">azm.question</field>
        <field name="arch" type="xml">
            <list string="كتالوج الأسئلة">
                <field name="code"/>
                <field name="stage_id"/>
                <field name="group"/>
                <field name="label"/>
                <field name="qtype"/>
                <field name="is_common" optional="show"/>
                <field name="raci" optional="hide"/>
            </list>
        </field>
    </record>

    <record id="azm_question_view_form" model="ir.ui.view">
        <field name="name">azm.question.view.form</field>
        <field name="model">azm.question</field>
        <field name="arch" type="xml">
            <form string="السؤال">
                <sheet>
                    <div class="oe_title">
                        <field name="code" class="text-muted"/>
                        <h2><field name="label" placeholder="نص السؤال"/></h2>
                    </div>
                    <group>
                        <group>
                            <field name="stage_id"/>
                            <field name="key"/>
                            <field name="group"/>
                            <field name="qtype"/>
                            <field name="sequence"/>
                        </group>
                        <group>
                            <field name="clause"/>
                            <field name="is_common"/>
                            <field name="is_role"/>
                            <field name="raci"/>
                        </group>
                    </group>
                    <group string="شرط الظهور">
                        <field name="condition" nolabel="1" colspan="2" widget="text"
                               placeholder='{"field": "boundary", "in": ["خارج النظام", "جزء داخل وجزء خارج"]}'/>
                    </group>
                    <notebook>
                        <page string="الاختيارات" name="options" invisible="qtype == 'number'">
                            <field name="option_ids">
                                <list editable="bottom">
                                    <field name="sequence" widget="handle"/>
                                    <field name="name"/>
                                    <field name="kind"/>
                                </list>
                            </field>
                        </page>
                        <page string="شرح للمجيب" name="help">
                            <field name="help_text"/>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <record id="azm_question_view_search" model="ir.ui.view">
        <field name="name">azm.question.view.search</field>
        <field name="model">azm.question</field>
        <field name="arch" type="xml">
            <search>
                <field name="label"/>
                <field name="code"/>
                <field name="stage_id"/>
                <filter name="common" string="مشتركة" domain="[('is_common', '=', True)]"/>
                <filter name="specific" string="خاصة بالمرحلة" domain="[('is_common', '=', False)]"/>
                <filter name="roles" string="أسئلة أدوار" domain="[('is_role', '=', True)]"/>
                <group>
                    <filter name="by_stage" string="المرحلة" context="{'group_by': 'stage_id'}"/>
                    <filter name="by_group" string="القسم" context="{'group_by': 'group'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="azm_question_action" model="ir.actions.act_window">
        <field name="name">كتالوج الأسئلة</field>
        <field name="res_model">azm.question</field>
        <field name="view_mode">list,form</field>
        <field name="context">{'search_default_by_stage': 1}</field>
    </record>
</odoo>
