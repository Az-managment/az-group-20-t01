["الإدارة الطالبة","مدير الكيان","المشتريات","حسب نوع الطلب"],"clause":"تُحدد الأولوية بواسطة","um":1},{"id":"invalid","label":"ماذا يحدث إذا كان الطلب ناقص البيانات؟","options":["يرجع لمقدم الطلب","يُستكمل بواسطة المشتريات","يستمر دون استكمال"],"clause":"يُعالج نقص بيانات الطلب بأن","um":1}]},{"id":"STK","name":"فحص المخزون والبدائل","input":"طلب احتياج","output":"قرار الصرف من المخزون أو الاستمرار في الشراء","owner":"أمين المخزن","fields":[{"id":"timing","label":"متى يُراجع رصيد المخزون؟","options":["قبل اعتماد طلب الشراء","قبل طلب عروض","بعد إصدار أمر الشراء"],"clause":"تتم مراجعة رصيد المخزون","um":1},{"id":"available","label":"ماذا يحدث إذا كان الصنف متاحًا في المخزون؟","options":["صرف من المخزون وإنهاء طلب الشراء","حجز الكمية ثم الصرف","استمرار الشراء رغم التوافر"],"clause":"عند توافر الصنف يتم","um":1},{"id":"partial","label":"ماذا يحدث إذا كان المتاح جزءًا من المطلوب؟","options":["صرف المتاح وشراء الباقي","شراء كامل الكمية","انتظار التوريد القادم"],"clause":"عند التوافر الجزئي يتم","um":1},{"id":"substitute","label":"هل تُراجَع البدائل أو التحويل من موقع آخر؟","options":["نعم","حسب نوع الصنف","لا"],"clause":"مراجعة البدائل والتحويل بين المواقع هي","um":1},{"id":"sub_approver","label":"من يعتمد الصنف البديل؟","options":"@R","clause":"صاحب قبول البديل هو","when":{"field":"substitute","in":["نعم","حسب نوع الصنف"]}},{"id":"balance","label":"ما مصدر الرصيد المستخدم في القرار؟","options":["رصيد نظام محدث","كشف يدوي","جرد فعلي","أكثر من مصدر"],"clause":"مصدر الرصيد المستخدم هو","um":1}]},{"id":"BUD","name":"مراجعة الموازنة","input":"طلب شراء مربوط بالمخصص","output":"نتيجة فحص المخصص وقرار الاستثناء","owner":"مسؤول الموازنة","fields":[{"id":"coverage","label":"المراجعة على كل العمليات؟","options":["كل العمليات","حسب نوع المشتريات","حسب قيمة الطلب"],"clause":"نطاق مراجعة الموازنة هو","um":1},{"id":"timing","label":"المراجعة بتحصل إمتى؟","options":["قبل اعتماد الطلب","قبل أمر الشراء","قبل التعاقد","بعد الالتزام بالشراء"],"clause":"يتم فحص المخصص","um":1},{"id":"dimensions","label":"على أي مستوى يُراجع المخصص؟","type":"multi","options":["مركز التكلفة","المشروع","الإدارة","بند الموازنة"],"clause":"تتم مراجعة المخصص على مستوى","um":1},{"id":"shortage","label":"ماذا يحدث إذا كان المخصص غير كافٍ؟","options":["إيقاف الطلب","مناقلة","زيادة مخصص","اعتماد استثنائي","استمرار الشراء"],"clause":"عند عدم كفاية المخصص يتم","um":1},{"id":"ex_timing","label":"الموافقة الاستثنائية بتحصل إمتى؟","options":["قبل الالتزام بالشراء","بعد الالتزام بالشراء"],"clause":"يتم اعتماد الاستثناء","when":{"field":"shortage","eq":"اعتماد استثنائي"},"um":1},{"id":"exception_approver","label":"من يعتمد استثناء الموازنة؟","options":"@R","clause":"صاحب اعتماد استثناء الموازنة","when":{"field":"shortage","eq":"اعتماد استثنائي"}},{"id":"exception_reject","label":"ماذا يحدث إذا رُفض استثناء الموازنة؟","options":["إلغاء الطلب","إعادة لمقدم الطلب","انتظار تعديل الموازنة"],"clause":"معالجة رفض استثناء الموازنة","when":{"field":"shortage","eq":"اعتماد استثنائي"},"um":1},{"id":"adjust_approver","label":"من يعتمد المناقلة أو زيادة المخصص؟","options":"@R","clause":"صاحب اعتماد تعديل الموازنة هو","when":{"field":"shortage","in":["مناقلة","زيادة مخصص"]}},{"id":"adjust_record","label":"هل يُسجَّل التعديل قبل استكمال الشراء؟","options":["نعم","لا","حسب الحالة"],"clause":"يُسجل تعديل الموازنة قبل استكمال الشراء","when":{"field":"shortage","in":["مناقلة","زيادة مخصص"]},"um":1},{"id":"reserve","label":"هل يُحجز المخصص عند الالتزام؟","options":["حجز عند الطلب","حجز عند أمر الشراء","حجز عند التعاقد","لا يوجد حجز"],"clause":"تُدار الالتزامات على الموازنة وفق","um":1},{"id":"release","label":"إلغاء الطلب أو تعديله بيحدّث المخصص؟","options":["نعم تلقائيًا","نعم يدويًا","لا"],"clause":"يُحدّث المخصص عند الإلغاء أو التعديل","um":1}]},{"id":"VEN","name":"تسجيل وتأهيل المورد","input":"طلب تسجيل أو تحديث مورد","output":"مورد مقبول أو مرفوض","owner":"مسؤول المشتريات","fields":[{"id":"onboard","label":"متى يُسجَّل المورد الجديد؟","options":["قبل التعامل","بعد أول طلب","عند ورود الفاتورة"],"clause":"يُسجل المورد الجديد","um":1},{"id":"duplicate","label":"كيف يُمنع تسجيل المورد نفسه أكثر من مرة؟","options":["فحص بالرقم الضريبي أو السجل التجاري","فحص بالاسم فقط","فحص بالحساب البنكي","مراجعة يدوية عند التسجيل","لا يوجد فحص"],"clause":"طريقة منع تكرار المورد هي","um":1},{"id":"checks","label":"ما الفحوص التي تُجرى عند تسجيل المورد؟","type":"multi","options":["اكتمال مستندات","ملاءمة فنية","تقييم مالي","تعارض مصالح","فحص بيانات بنكية","كشف مورد مكرر","لا يوجد"],"clause":"تشمل فحوص المورد","um":1},{"id":"bank","label":"كيف يُتحقق من تغيير الحساب البنكي؟","options":["تحقق مستقل بقناة موثوقة","الاعتماد على رسالة المورد فقط","تعديل دون تحقق"],"clause":"تُراجع تغييرات بيانات البنك بواسطة","um":1},{"id":"bank_approver","label":"من يعتمد تغيير الحساب البنكي؟","options":"@R","clause":"صاحب اعتماد تغيير البيانات البنكية هو"},{"id":"conflict","label":"ماذا يحدث إذا ظهر تعارض مصالح؟","options":["إيقاف وإحالة للمراجعة","إفصاح واعتماد استثناء","استمرار دون إجراء"],"clause":"تُعالج حالة تعارض المصالح بأن","um":1},{"id":"blocked","label":"هل يجوز التعامل مع مورد موقوف؟","options":["النظام يمنع التعامل","منع يدوي بالمراجعة","يمكن التعامل دون منع"],"clause":"تُعالج حالة المورد الموقوف وفق","um":1},{"id":"review","label":"هل يُعاد تقييم المورد؟","options":["دورية محددة","عند مشكلة أو تجديد","لا يوجد تقييم"],"clause":"إعادة تقييم المورد تتم","um":1}]},{"id":"RFQ","name":"طلب عروض الأسعار","input":"طلب شراء بمواصفات","output":"عروض أسعار قابلة للمقارنة","owner":"مسؤول المشتريات","fields":[{"id":"method","label":"كيف تُطلب عروض الأسعار؟","options":["منافسة بين موردين","شراء مباشر","مورد وحيد","حسب النوع والقيمة"],"clause":"طريقة الحصول على عروض هي","um":1},{"id":"quote_rule","label":"كيف يُحدَّد عدد العروض المطلوبة؟","options":["عدد ثابت","حسب شرائح القيمة","حسب النوع","لا توجد قاعدة"],"clause":"قاعدة عدد العروض هي","um":1},{"id":"quote_count","label":"كم عرضًا مطلوبًا؟","type":"number","clause":"عدد العروض المطلوب","when":{"field":"quote_rule","eq":"عدد ثابت"}},{"id":"same_specs","label":"الموردين بياخدوا نفس المواصفات؟","options":["نعم","لا","حسب الحالة"],"clause":"توحيد المواصفات المرسلة للموردين هو","um":1},{"id":"short_quotes","label":"ماذا يحدث إذا وردت عروض أقل من العدد المطلوب؟","options":["إعادة الطلب","اعتماد استثناء","استمرار دون استثناء"],"clause":"عند نقص عدد العروض يتم","um":1},{"id":"waiver","label":"من يعتمد الاستثناء من طلب العروض؟","options":"@R","clause":"صاحب اعتماد استثناء العروض هو","when":{"any":[{"field":"short_quotes","eq":"اعتماد استثناء"},{"field":"method","in":["شراء مباشر","مورد وحيد"]}]}},{"id":"confidential","label":"كيف تُفتح العروض وتُحفظ؟","options":["لجنة وفتح موثق","مسؤول مشتريات وسجل فتح","متداولة دون سجل فتح"],"clause":"طريقة فتح وحفظ العروض هي","um":1}]},{"id":"AWD","name":"المقارنة والترسية","input":"عروض ومواصفات ومعايير تقييم","output":"قرار ترسية مبرر","owner":"لجنة التقييم","fields":[{"id":"criteria","label":"على أي أساس يقع الاختيار؟","type":"multi","options":["السعر","المطابقة الفنية","مدة التوريد","شروط السداد","الضمان والدعم","تقييم المورد"],"clause":"تشمل معايير المفاضلة","um":1},{"id":"tech","label":"هل التقييم الفني منفصل عن التقييم التجاري؟","options":["نعم","لا","حسب نوع الشراء"],"clause":"الفصل بين التقييم الفني والتجاري هو","um":1},{"id":"scoring","label":"هل تُحدَّد المعايير قبل استلام العروض؟","options":["نعم","لا","بعضها فقط"],"clause":"تُحدد المعايير قبل استلام العروض","um":1},{"id":"not_lowest","label":"ماذا يحدث إذا لم يكن الاختيار أقل سعرًا؟","options":["مبرر موثق واعتماد","مبرر دون اعتماد إضافي","اختيار دون مبرر موثق"],"clause":"عند اختيار غير الأقل سعرًا يتم","um":1},{"id":"negotiation","label":"هل يُوثَّق التفاوض؟","options":["محضر تفاوض وعرض نهائي","العرض النهائي فقط","لا يوجد توثيق"],"clause":"توثيق التفاوض يكون في","um":1},{"id":"interest","label":"هل يُفصح أعضاء لجنة التقييم عن تعارض المصالح؟","options":["نعم","لا"],"clause":"إفصاح أعضاء التقييم عن المصالح هو","um":1}]},{"id":"ORD","name":"أمر الشراء والعقد","input":"طلب وقرار ترسية","output":"التزام شراء معتمد","owner":"مسؤول المشتريات","fields":[{"id":"commitment","label":"بأي مستند يُوثَّق الشراء؟","options":["أمر شراء","عقد","أمر شراء وعقد","اتفاق دون أمر أو عقد"],"clause":"أداة إثبات الالتزام هي","um":1},{"id":"before","label":"الاعتماد قبل إرسال الالتزام للمورد؟","options":["نعم","لا","حسب الحالة"],"clause":"توقيت الاعتماد بالنسبة لإرسال الالتزام هو","um":1},{"id":"legal","label":"العقود بتراجعها الشؤون القانونية؟","options":["كل العقود","حسب النوع والقيمة","لا توجد مراجعة"],"clause":"مراجعة العقود القانونية هي","um":1},{"id":"changes","label":"كيف تُعالَج التعديلات على أمر الشراء أو العقد؟","options":["إصدار تعديل وإعادة اعتماد","تعديل دون إعادة اعتماد","إلغاء وإصدار جديد"],"clause":"تُعالج تعديلات الالتزام وفق","um":1},{"id":"split","label":"هل تُفحص تجزئة الطلبات للتحايل على حدود الاعتماد؟","options":["فحص بالنظام","مراجعة يدوية","لا يوجد فحص"],"clause":"فحص تجزئة الطلبات يتم بواسطة","um":1},{"id":"cancellation","label":"هل يُوثَّق الإلغاء ويُبلَّغ به المورد؟","options":["نعم موثق","إبلاغ دون توثيق","لا يوجد إجراء ثابت"],"clause":"إلغاء الالتزام وإبلاغ المورد يتم وفق","um":1},{"id":"renewal","label":"هل يُتابَع التجديد التلقائي للعقود؟","options":["تنبيه قبل التجديد ومراجعة","مراجعة عند الاستحقاق","لا توجد متابعة","لا ينطبق"],"clause":"متابعة التجديد التلقائي هي","um":1}]},{"id":"RCV","name":"الاستلام والفحص وقبول الخدمة","input":"توريد أو إنجاز مرتبط بالالتزام","output":"قبول كمي أو فني أو خدمة","owner":"لجنة الفحص والاستلام","fields":[{"id":"acceptance","label":"ما إثبات الاستلام المعتمد لديكم؟","options":["إذن استلام وفحص أصناف","محضر قبول خدمة","مستخلص أعمال معتمد","إثبات تفعيل اشتراك","حسب نوع التوريد"],"clause":"يُثبت الاستلام أو الإنجاز بواسطة","um":1},{"id":"independent","label":"هل المستلم مستقل عن المشتري؟","options":["أشخاص مختلفون","نفس الشخص مع فحص مستقل","نفس الشخص دون فحص مستقل"],"clause":"استقلال الاستلام عن الشراء هو","um":1},{"id":"partial","label":"كيف يُعالَج التوريد أو الإنجاز الجزئي؟","options":["تسجيل الجزء المقبول وإبقاء الباقي مفتوحًا","إثبات كامل الطل