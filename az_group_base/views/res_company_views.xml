<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_company_form" model="ir.ui.view">
        <field name="name">res.company.form.inherit.az.group</field>
        <field name="model">res.company</field>
        <field name="inherit_id" ref="base.view_company_form"/>
        <field name="arch" type="xml">
            <!-- The first name field of the parent view sits inside the title
                 h1, so anchor on the General Information group instead. -->
            <xpath expr="//page[@name='general_info']//field[@name='currency_id']" position="before">
                <field name="code" placeholder="e.g. FUE"/>
                <field name="name_ar"/>
            </xpath>
        </field>
    </record>
</odoo>
