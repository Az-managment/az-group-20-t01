<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="action_azm_dashboard" model="ir.actions.client">
        <field name="name">Home</field>
        <field name="tag">azm_dashboard</field>
    </record>

    <menuitem id="menu_root" name="AZM"
              web_icon="azm_platform,static/description/icon.png"
              groups="group_azm_user" sequence="1"/>

    <menuitem id="menu_home" name="Home" parent="menu_root" action="action_azm_dashboard" sequence="1"/>
    <menuitem id="menu_entities" name="Entities" parent="menu_root" action="action_azm_entity" sequence="2"/>
    <menuitem id="menu_structure" name="Group Structure" parent="menu_root" action="action_azm_entity_hierarchy" sequence="3"/>

    <!-- Existing apps, shown inside the AZM shell -->
    <menuitem id="menu_employees" name="Employees" parent="menu_root" action="hr.open_view_employee_list_my" sequence="20" groups="hr.group_hr_user"/>
    <menuitem id="menu_departments" name="Departments &amp; Teams" parent="menu_root" action="hr.hr_department_kanban_action" sequence="21" groups="hr.group_hr_user"/>
    <menuitem id="menu_projects" name="Projects" parent="menu_root" action="project.open_view_project_all" sequence="22" groups="project.group_project_user"/>
    <menuitem id="menu_tasks" name="Tasks" parent="menu_root" action="project.action_view_all_task" sequence="23" groups="project.group_project_user"/>
    <menuitem id="menu_documents" name="Documents" parent="menu_root" action="action_azm_documents" sequence="24"/>

    <menuitem id="menu_settings" name="Platform Settings" parent="menu_root" action="action_azm_settings"
              sequence="40" groups="base.group_system"/>
</odoo>
