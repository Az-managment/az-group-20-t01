<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Use the AZM layout for the login page only (reset password & co keep Odoo's layout). -->
    <template id="login" inherit_id="web.login" name="AZM Login">
        <xpath expr="//t[@t-call='web.login_layout']" position="attributes">
            <attribute name="t-call">azm_platform.login_layout</attribute>
        </xpath>
    </template>

    <template id="login_layout" name="AZM Login Layout">
        <t t-set="head">
            <t t-out="head"/>
        </t>
        <t t-call="web.frontend_layout"
           html_data="{'style': 'height: 100%;'}"
           body_classname.f="o_azm_login_body"
           no_header="True"
           no_footer="True"
           head="head">
            <div class="o_azm_login">
                <div class="o_azm_login_card_wrap">
                    <div class="o_azm_login_card">
                        <div class="text-center mb-4">
                            <div class="o_azm_welcome">Welcome to</div>
                            <div class="o_azm_big_logo">AZM</div>
                            <div class="o_azm_card_title">Enterprise Operating Model Platform</div>
                            <div class="o_azm_card_subtitle">Sign in to continue</div>
                        </div>
                        <t t-out="0"/>
                    </div>
                </div>
            </div>
        </t>
    </template>
</odoo>
