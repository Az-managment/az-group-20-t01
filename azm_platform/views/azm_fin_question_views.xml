<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- Sub-topics -->
    <record id="azm_fin_topic_view_list" model="ir.ui.view">
        <field name="name">azm.fin.topic.list</field>
        <field name="model">azm.fin.topic</field>
        <field name="arch" type="xml">
            <list string="المواضيع الفرعية">
                <field name="code"/>
                <field name="module_id"/>
                <field name="name"/>
                <field name="requirement_count"/>
                <field name="opening_question_count"/>
            </list>
        </field>
    </record>

    <record id="azm_fin_topic_view_form" model="ir.ui.view">
        <field name="name">azm.fin.topic.form</field>
        <field name="model">azm.fin.topic</field>
        <field name="arch" type="xml">
            <form string="موضوع فرعي">
                <sheet>
                    <div class="oe_title">
                        <h3><field name="code" readonly="1"/></h3>
                        <h1><field name="name"/></h1>
                    </div>
                    <group>
                        <field name="module_id"/>
                        <field name="sequence"/>
                        <field name="active" invisible="1"/>
                    </group>
                    <notebook>
                        <page string="المتطلبات" name="requirements">
                            <field name="requirement_ids" readonly="1">
                                <list>
                                    <field name="code"/>
                                    <field name="title"/>
                                    <field name="profile"/>
                                    <field name="question_count"/>
                                </list>
                            </field>
                        </page>
                        <page string="الأسئلة الافتتاحية" name="opening">
                            <field name="opening_question_ids" readonly="1">
                                <list>
                                    <field name="axis"/>
                                    <field name="stage"/>
                                    <field name="question"/>
                                    <field name="output" optional="show"/>
                                </list>
                            </field>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <!-- Questions -->
    <record id="azm_fin_question_view_list" model="ir.ui.view">
        <field name="name">azm.fin.question.list</field>
        <field name="model">azm.fin.question</field>
        <field name="arch" type="xml">
            <list string="الأسئلة">
                <field name="code"/>
                <field name="module_id" optional="show"/>
                <field name="requirement_id" optional="show"/>
                <field name="key"/>
                <field name="role"/>
                <field name="qtype"/>
                <field name="label"/>
                <field name="option_count"/>
                <field name="condition" optional="hide"/>
            </list>
        </field>
    </record>

    <record id="azm_fin_question_view_form" model="ir.ui.view">
        <field name="name">azm.fin.question.form</field>
        <field name="model">azm.fin.question</field>
        <field name="arch" type="xml">
            <form string="سؤال">
                <sheet>
                    <div class="oe_title">
                        <h3><field name="code" readonly="1"/></h3>
                        <h1><field name="label"/></h1>
                    </div>
                    <group>
                        <group>
                            <field name="requirement_id"/>
                            <field name="topic_id" readonly="1"/>
                            <field name="key"/>
                            <field name="role"/>
                        </group>
                        <group>
                            <field name="qtype"/>
                            <field name="sequence"/>
                            <field name="unit" invisible="qtype != 'number'"/>
                            <field name="response_type" readonly="1"/>
                            <field name="active" invisible="1"/>
                        </group>
                    </group>
                    <group string="المطلوب في الإجابة">
                        <field name="help_text" nolabel="1"/>
                        <field name="text_label"/>
                    </group>
                    <notebook>
                        <page string="الاختيارات" name="options" invisible="qtype not in ('select', 'multi')">
                            <field name="option_ids">
                                <list editable="bottom">
                                    <field name="sequence" widget="handle"/>
                                    <field name="name"/>
                                    <field name="kind"/>
                                </list>
                            </field>
                        </page>
                        <page string="أعمدة الجدول" name="columns" invisible="qtype != 'table'">
                            <field name="columns_json" nolabel="1"/>
                        </page>
                        <page string="شرط الظهور" name="condition">
                            <field name="condition" nolabel="1"
                                   placeholder='{"field": "Q003", "in": ["مطبق بالكامل"]}'/>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <record id="azm_fin_question_view_search" model="ir.ui.view">
        <field name="name">azm.fin.question.search</field>
        <field name="model">azm.fin.question</field>
        <field name="arch" type="xml">
            <search>
                <field name="label"/>
                <field name="code"/>
                <field name="requirement_id"/>
                <field name="module_id"/>
                <filter name="specific" string="أسئلة المتطلب" domain="[('role', 'in', ('main', 'followup'))]"/>
                <filter name="standard" string="الأسئلة القياسية" domain="[('role', 'in', ('state', 'impl', 'rule', 'target'))]"/>
                <filter name="conditional" string="لها شرط ظهور" domain="[('condition', '!=', False)]"/>
                <group>
                    <filter name="by_module" string="الموديول" context="{'group_by': 'module_id'}"/>
                    <filter name="by_requirement" string="المتطلب" context="{'group_by': 'requirement_id'}"/>
                    <filter name="by_role" string="الدور" context="{'group_by': 'role'}"/>
                    <filter name="by_qtype" string="شكل الإجابة" context="{'group_by': 'qtype'}"/>
                </group>
            </search>
        </field>
    </record>

    <!-- Opening questions -->
    <record id="azm_fin_opening_question_view_list" model="ir.ui.view">
        <field name="name">azm.fin.opening.question.list</field>
        <field name="model">azm.fin.opening.question</field>
        <field name="arch" type="xml">
            <list string="الأسئلة الافتتاحية" create="0">
                <field name="node" optional="hide"/>
                <field name="module_id"/>
                <field name="topic_id"/>
                <field name="axis"/>
                <field name="stage"/>
                <field name="question"/>
                <field name="output" optional="show"/>
            </list>
        </field>
    </record>

    <record id="azm_fin_opening_question_view_search" model="ir.ui.view">
        <field name="name">azm.fin.opening.question.search</field>
        <field name="model">azm.fin.opening.question</field>
        <field name="arch" type="xml">
            <search>
                <field name="question"/>
                <field name="topic_id"/>
                <field name="module_id"/>
                <field name="axis"/>
                <group>
                    <filter name="by_module" string="الموديول" context="{'group_by': 'module_id'}"/>
                    <filter name="by_topic" string="الموضوع الفرعي" context="{'group_by': 'topic_id'}"/>
                    <filter name="by_axis" string="المحور" context="{'group_by': 'axis'}"/>
                    <filter name="by_stage" string="المرحلة" context="{'group_by': 'stage'}"/>
                </group>
            </search>
        </field>
    </record>

    <!-- Actions -->
    <record id="azm_fin_topic_action" model="ir.actions.act_window">
        <field name="name">المواضيع الفرعية</field>
        <field name="res_model">azm.fin.topic</field>
        <field name="view_mode">list,form</field>
        <field name="context">{'search_default_by_module': 1}</field>
    </record>

    <record id="azm_fin_question_action" model="ir.actions.act_window">
        <field name="name">أسئلة النموذج المالي</field>
        <field name="res_model">azm.fin.question</field>
        <field name="view_mode">list,form</field>
        <field name="context">{'search_default_by_requirement': 1}</field>
    </record>

    <record id="azm_fin_opening_question_action" model="ir.actions.act_window">
        <field name="name">الأسئلة الافتتاحية</field>
        <field name="res_model">azm.fin.opening.question</field>
        <field name="view_mode">list</field>
        <field name="context">{'search_default_by_topic': 1}</field>
    </record>

    <menuitem id="azm_fin_topic_menu" name="المواضيع الفرعية"
              parent="azm_operating_model.azm_menu_config"
              action="azm_fin_topic_action" sequence="62"/>
    <menuitem id="azm_fin_question_menu" name="أسئلة النموذج المالي"
              parent="azm_operating_model.azm_menu_config"
              action="azm_fin_question_action" sequence="64"/>
    <menuitem id="azm_fin_opening_question_menu" name="الأسئلة الافتتاحية"
              parent="azm_operating_model.azm_menu_config"
              action="azm_fin_opening_question_action" sequence="66"/>

</odoo>
