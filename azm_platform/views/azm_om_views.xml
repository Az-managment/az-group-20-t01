<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Model domain on the question areas (stages) -->
    <record id="azm_stage_view_list_inherit_platform" model="ir.ui.view">
        <field name="name">azm.stage.view.list.inherit.platform</field>
        <field name="model">azm.stage</field>
        <field name="inherit_id" ref="azm_operating_model.azm_stage_view_list"/>
        <field name="arch" type="xml">
            <field name="default_owner" position="after">
                <field name="azm_domain" widget="badge"
                       decoration-info="azm_domain == 'procurement'"
                       decoration-success="azm_domain == 'financial'"
                       decoration-warning="azm_domain == 'governance'"/>
            </field>
        </field>
    </record>

    <record id="azm_stage_view_form_inherit_platform" model="ir.ui.view">
        <field name="name">azm.stage.view.form.inherit.platform</field>
        <field name="model">azm.stage</field>
        <field name="inherit_id" ref="azm_operating_model.azm_stage_view_form"/>
        <field name="arch" type="xml">
            <field name="is_governance" position="after">
                <field name="azm_domain" widget="radio" options="{'horizontal': true}"/>
            </field>
        </field>
    </record>

    <record id="azm_question_view_list_inherit_platform" model="ir.ui.view">
        <field name="name">azm.question.view.list.inherit.platform</field>
        <field name="model">azm.question</field>
        <field name="inherit_id" ref="azm_operating_model.azm_question_view_list"/>
        <field name="arch" type="xml">
            <field name="stage_id" position="after">
                <field name="azm_domain" optional="show" widget="badge"
                       decoration-info="azm_domain == 'procurement'"
                       decoration-success="azm_domain == 'financial'"
                       decoration-warning="azm_domain == 'governance'"/>
            </field>
        </field>
    </record>

    <record id="azm_question_view_search_inherit_platform" model="ir.ui.view">
        <field name="name">azm.question.view.search.inherit.platform</field>
        <field name="model">azm.question</field>
        <field name="inherit_id" ref="azm_operating_model.azm_question_view_search"/>
        <field name="arch" type="xml">
            <filter name="common" position="before">
                <filter name="domain_governance" string="Governance" domain="[('azm_domain', '=', 'governance')]"/>
                <filter name="domain_procurement" string="Procurement Operations" domain="[('azm_domain', '=', 'procurement')]"/>
                <filter name="domain_financial" string="Financial" domain="[('azm_domain', '=', 'financial')]"/>
                <separator/>
            </filter>
            <filter name="by_stage" position="before">
                <filter name="by_domain" string="Model Domain" context="{'group_by': 'azm_domain'}"/>
            </filter>
        </field>
    </record>

    <record id="azm_finding_view_search_inherit_platform" model="ir.ui.view">
        <field name="name">azm.finding.view.search.inherit.platform</field>
        <field name="model">azm.finding</field>
        <field name="inherit_id" ref="azm_operating_model.azm_finding_view_search"/>
        <field name="arch" type="xml">
            <xpath expr="//search" position="inside">
                <separator/>
                <filter name="domain_governance" string="Governance" domain="[('azm_domain', '=', 'governance')]"/>
                <filter name="domain_procurement" string="Procurement Operations" domain="[('azm_domain', '=', 'procurement')]"/>
                <filter name="domain_financial" string="Financial" domain="[('azm_domain', '=', 'financial')]"/>
                <filter name="by_domain" string="Model Domain" context="{'group_by': 'azm_domain'}"/>
            </xpath>
        </field>
    </record>

    <!-- Link entities to companies (shown even without multi-company) -->
    <record id="azm_entity_view_list_inherit_platform" model="ir.ui.view">
        <field name="name">azm.entity.view.list.inherit.platform</field>
        <field name="model">azm.entity</field>
        <field name="inherit_id" ref="azm_operating_model.azm_entity_view_list"/>
        <field name="arch" type="xml">
            <field name="company_id" position="attributes">
                <attribute name="groups"/>
                <attribute name="string">Company (AZM Platform)</attribute>
            </field>
        </field>
    </record>
</odoo>
