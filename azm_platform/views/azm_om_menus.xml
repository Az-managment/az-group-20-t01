<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="action_azm_om_dashboard" model="ir.actions.client">
        <field name="name">Operating Model</field>
        <field name="tag">azm_om_dashboard</field>
    </record>

    <record id="action_azm_om_hub" model="ir.actions.client">
        <field name="name">Operating Models</field>
        <field name="tag">azm_om_hub</field>
    </record>

    <record id="action_azm_om_assessments" model="ir.actions.client">
        <field name="name">Assessments</field>
        <field name="tag">azm_om_assessments</field>
    </record>
    <record id="action_azm_om_register" model="ir.actions.client">
        <field name="name">Risk Register</field>
        <field name="tag">azm_om_register</field>
    </record>

    <!-- Inside the AZM platform shell (sidebar) -->
    <menuitem id="menu_om_dashboard" name="Operating Models" parent="azm_platform.menu_root"
              action="action_azm_om_hub" sequence="5"
              groups="azm_operating_model.azm_group_user"/>
    <menuitem id="menu_om_assessments" name="Assessments" parent="azm_platform.menu_root"
              action="action_azm_om_assessments" sequence="6"
              groups="azm_operating_model.azm_group_user"/>
    <menuitem id="menu_om_findings" name="Risk Register" parent="azm_platform.menu_root"
              action="action_azm_om_register" sequence="7"
              groups="azm_operating_model.azm_group_user"/>
    <menuitem id="menu_om_questions" name="Question Catalogue" parent="azm_platform.menu_root"
              action="azm_operating_model.azm_question_action" sequence="10"
              groups="azm_operating_model.azm_group_manager"/>

    <!-- Unified financial model -->
    <record id="action_azm_fin_dashboard" model="ir.actions.client">
        <field name="name">Unified Financial Model</field>
        <field name="tag">azm_fin_dashboard</field>
    </record>
    <menuitem id="menu_fin_dashboard_in_om" name="لوحة النموذج المالي" parent="azm_operating_model.azm_fin_menu_root"
              action="action_azm_fin_dashboard" sequence="1"/>

    <!-- =================================================================== Trees
         Every model that can be walked branch by branch. The landing page lists them
         with a card per entity; the cards open the tree of that entity and that model. -->
    <record id="action_azm_trees" model="ir.actions.client">
        <field name="name">Trees</field>
        <field name="tag">azm_trees</field>
    </record>

    <!-- FIN › module › topic › requirement, with each document beside it -->
    <record id="action_azm_fin_tree" model="ir.actions.client">
        <field name="name">Financial Model Tree</field>
        <field name="tag">azm_fin_tree</field>
    </record>

    <!-- PUR › stage › group › question, with each answer and its risks beside it -->
    <record id="action_azm_proc_tree" model="ir.actions.client">
        <field name="name">Procurement Cycle Tree</field>
        <field name="tag">azm_proc_tree</field>
    </record>

    <!-- =========================================================== My work
         The Home page is the group's cockpit. This is the other page: one person's own
         entities, what they still owe, where their work stands, and — for a reviewer —
         what is waiting for them. It sits first, because for most people it is the only
         page they need. -->
    <record id="action_azm_my_work" model="ir.actions.client">
        <field name="name">My work</field>
        <field name="tag">azm_my_work</field>
    </record>
    <menuitem id="menu_my_work" name="My work" parent="azm_platform.menu_root"
              action="action_azm_my_work" sequence="0"
              groups="azm_operating_model.azm_group_user"/>

    <!-- =========================================================== Outputs library
         The trees read one model for one entity; the library reads one deliverable
         across every entity, which is the question the trees cannot answer. -->
    <record id="action_azm_outputs_library" model="ir.actions.client">
        <field name="name">Outputs Library</field>
        <field name="tag">azm_outputs_library</field>
    </record>
    <menuitem id="menu_outputs_library" name="Outputs Library" parent="azm_platform.menu_root"
              action="action_azm_outputs_library" sequence="9"
              groups="azm_operating_model.azm_group_user"/>

    <menuitem id="menu_trees" name="Trees" parent="azm_platform.menu_root"
              action="action_azm_trees" sequence="8"
              groups="azm_operating_model.azm_group_user"/>
    <menuitem id="menu_trees_in_om" name="شجر" parent="azm_operating_model.azm_menu_root"
              action="action_azm_trees" sequence="25"
              groups="azm_operating_model.azm_group_user"/>

    <!-- Same page from the Operating Model app itself -->
    <menuitem id="menu_om_dashboard_in_om" name="نماذج التشغيل" parent="azm_operating_model.azm_menu_root"
              action="action_azm_om_hub" sequence="1"/>
</odoo>
