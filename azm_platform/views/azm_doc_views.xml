<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- ============================================================ published documents -->
    <record id="azm_doc_publication_view_list" model="ir.ui.view">
        <field name="name">azm.doc.publication.view.list</field>
        <field name="model">azm.doc.publication</field>
        <field name="arch" type="xml">
            <list string="المستندات" create="0" delete="0" decoration-muted="state == 'empty'"
                  decoration-danger="state == 'error'">
                <field name="name"/>
                <field name="company_id" optional="show"/>
                <field name="module_id" optional="show"/>
                <field name="kind" optional="hide"/>
                <field name="folder_id" optional="hide"/>
                <field name="state" widget="badge" decoration-success="state == 'done'"
                       decoration-info="state == 'pending'" decoration-danger="state == 'error'"/>
                <field name="generated_on" optional="show"/>
                <field name="retry_after" optional="hide"/>
                <field name="attempts" optional="hide"/>
                <button name="action_read" type="object" icon="description" title="قراءة · Read"
                        invisible="state == 'empty'"/>
                <button name="action_download" type="object" icon="download" title="تنزيل · Download"
                        invisible="state == 'empty'"/>
                <button name="action_open_folder" type="object" icon="folder_open" title="فتح في Documents"
                        invisible="state != 'done'"/>
            </list>
        </field>
    </record>

    <record id="azm_doc_publication_view_form" model="ir.ui.view">
        <field name="name">azm.doc.publication.view.form</field>
        <field name="model">azm.doc.publication</field>
        <field name="arch" type="xml">
            <form string="مستند" create="0" delete="0">
                <header>
                    <button name="action_read" type="object" string="قراءة المستند" class="btn-primary"
                            icon="description" invisible="state == 'empty'"/>
                    <button name="action_download" type="object" string="تنزيل" icon="download"
                            invisible="state == 'empty'"/>
                    <button name="action_open_folder" type="object" string="فتح في Documents" icon="folder_open"
                            invisible="state != 'done'"/>
                    <button name="action_refresh" type="object" string="تحديث الآن" icon="refresh"/>
                    <field name="state" widget="statusbar" statusbar_visible="pending,done"/>
                </header>
                <sheet>
                    <div class="oe_title">
                        <field name="kind" class="text-muted"/>
                        <h1><field name="name"/></h1>
                    </div>
                    <group>
                        <group>
                            <field name="company_id"/>
                            <field name="module_id"/>
                            <field name="requirement_id" invisible="kind != 'requirement'"/>
                            <field name="tab" invisible="kind != 'module'"/>
                        </group>
                        <group>
                            <field name="folder_id"/>
                            <field name="assessment_id"/>
                            <field name="generated_on"/>
                            <field name="outdated"/>
                        </group>
                    </group>
                    <group string="الخطأ · Error" invisible="state != 'error'">
                        <field name="error" nolabel="1" readonly="1"/>
                        <label for="attempts"/>
                        <div>
                            <field name="attempts" class="oe_inline" readonly="1"/>
                            <span invisible="not retry_after">
                                — إعادة المحاولة تلقائيًا في <field name="retry_after" class="oe_inline" readonly="1"/>
                            </span>
                            <span class="text-muted" invisible="retry_after">
                                — انتهت المحاولات التلقائية؛ استخدم «تحديث الآن».
                            </span>
                        </div>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="azm_doc_publication_view_search" model="ir.ui.view">
        <field name="name">azm.doc.publication.view.search</field>
        <field name="model">azm.doc.publication</field>
        <field name="arch" type="xml">
            <search>
                <field name="name"/>
                <field name="tree_ref"/>
                <field name="company_id"/>
                <field name="module_id"/>
                <filter name="requirements" string="أوراق المتطلبات" domain="[('kind', '=', 'requirement')]"/>
                <filter name="outputs" string="مخرجات الموديولات" domain="[('kind', '=', 'module')]"/>
                <separator/>
                <filter name="ready" string="جاهز" domain="[('state', '=', 'done')]"/>
                <filter name="pending" string="في الانتظار" domain="[('state', '=', 'pending')]"/>
                <filter name="errors" string="أخطاء" domain="[('state', '=', 'error')]"/>
                <filter name="retrying" string="في انتظار إعادة المحاولة"
                        domain="[('state', '=', 'error'), ('retry_after', '!=', False)]"/>
                <filter name="gave_up" string="توقفت المحاولات"
                        domain="[('state', '=', 'error'), ('retry_after', '=', False)]"/>
                <group>
                    <filter name="by_company" string="الكيان" context="{'group_by': 'company_id'}"/>
                    <filter name="by_kind" string="النوع" context="{'group_by': 'kind'}"/>
                    <filter name="by_module" string="الموديول" context="{'group_by': 'module_id'}"/>
                    <filter name="by_state" string="الحالة" context="{'group_by': 'state'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="action_azm_doc_publication" model="ir.actions.act_window">
        <field name="name">المستندات · Documents</field>
        <field name="res_model">azm.doc.publication</field>
        <field name="view_mode">list,form</field>
        <field name="domain">[('state', '!=', 'empty')]</field>
        <field name="context">{'search_default_by_company': 1, 'search_default_by_module': 1}</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">لا توجد مستندات بعد</p>
            <p>افتح إفادة مالية واضغط «نشر المستندات» لإنشاء ورقة لكل متطلب في مجلدات الكيان.</p>
        </field>
    </record>

    <menuitem id="menu_azm_doc_publication" name="المستندات" parent="azm_operating_model.azm_fin_menu_root"
              action="action_azm_doc_publication" sequence="30"/>

    <!-- ============================================================ requirement -->
    <record id="azm_fin_requirement_view_form_docs" model="ir.ui.view">
        <field name="name">azm.fin.requirement.view.form.docs</field>
        <field name="model">azm.fin.requirement</field>
        <field name="inherit_id" ref="azm_operating_model.azm_fin_requirement_view_form"/>
        <field name="arch" type="xml">
            <xpath expr="//sheet" position="before">
                <header>
                    <button name="action_azm_publish_documents" type="object" string="تحديث المستندات لكل الكيانات"
                            icon="refresh" groups="azm_operating_model.azm_group_manager"/>
                </header>
            </xpath>
            <xpath expr="//field[@name='question_ids']" position="after">
                <separator string="المستندات · Documents"/>
                <field name="azm_doc_ids" readonly="1" nolabel="1">
                    <list create="0" delete="0">
                        <field name="company_id"/>
                        <field name="state" widget="badge" decoration-success="state == 'done'"
                               decoration-info="state == 'pending'" decoration-danger="state == 'error'"/>
                        <field name="generated_on"/>
                        <button name="action_read" type="object" string="قراءة" icon="description"/>
                        <button name="action_download" type="object" string="تنزيل" icon="download"/>
                        <button name="action_open_folder" type="object" icon="folder_open" title="فتح في Documents"
                                invisible="state != 'done'"/>
                    </list>
                </field>
            </xpath>
        </field>
    </record>

    <!-- ============================================================ answer lines / gap register -->
    <record id="azm_fin_answer_view_list_docs" model="ir.ui.view">
        <field name="name">azm.fin.answer.view.list.docs</field>
        <field name="model">azm.fin.answer</field>
        <field name="inherit_id" ref="azm_operating_model.azm_fin_answer_view_list"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='is_done']" position="after">
                <button name="action_azm_doc_read" type="object" icon="description" title="قراءة المستند"/>
                <button name="action_azm_doc_download" type="object" icon="download" title="تنزيل المستند"/>
            </xpath>
        </field>
    </record>

    <record id="azm_fin_answer_view_form_docs" model="ir.ui.view">
        <field name="name">azm.fin.answer.view.form.docs</field>
        <field name="model">azm.fin.answer</field>
        <field name="inherit_id" ref="azm_operating_model.azm_fin_answer_view_form"/>
        <field name="arch" type="xml">
            <xpath expr="//sheet" position="before">
                <header>
                    <button name="action_azm_doc_read" type="object" string="قراءة المستند" class="btn-primary"
                            icon="description"/>
                    <button name="action_azm_doc_download" type="object" string="تنزيل" icon="download"/>
                </header>
            </xpath>
        </field>
    </record>

    <!-- ============================================================ assessment -->
    <record id="azm_fin_assessment_view_form_docs" model="ir.ui.view">
        <field name="name">azm.fin.assessment.view.form.docs</field>
        <field name="model">azm.fin.assessment</field>
        <field name="inherit_id" ref="azm_operating_model.azm_fin_assessment_view_form"/>
        <field name="arch" type="xml">
            <xpath expr="//header/field[@name='state']" position="before">
                <button name="action_azm_publish_documents" type="object" string="نشر المستندات"
                        icon="upload_file" groups="azm_operating_model.azm_group_reviewer"/>
            </xpath>
            <xpath expr="//div[@name='button_box']" position="inside">
                <button name="action_azm_view_documents" type="object" class="oe_stat_button" icon="description">
                    <field name="azm_doc_count" string="مستند" widget="statinfo"/>
                </button>
            </xpath>
        </field>
    </record>
</odoo>
