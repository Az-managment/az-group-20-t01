<?xml version="1.0" encoding="UTF-8"?>
<templates xml:space="preserve">

<t t-name="azm_platform.TreesHub">
    <div class="o_action o_azm_dashboard o_azm_om o_azm_trees" dir="rtl">
        <div class="o_azm_om_title o_azm_trees_title">
            <span class="o_azm_trees_title_mark"><t t-call="azm_platform.TreeMark"/></span>
            <div>
                <h1>شجر <small class="text-muted">Trees</small></h1>
                <p class="text-muted mb-0">
                    كل نموذج يمكن السير فيه فرعًا بفرع — اختر كيانًا لتفتح شجرته.
                    <small class="o_azm_en">Every model the group can walk branch by branch — pick an entity to open its own tree.</small>
                </p>
            </div>
        </div>

        <div t-if="!this.state.loaded" class="o_azm_loading">
            <i class="oi oi-spin" data-icon="progress_activity" title="Loading"/>
        </div>
        <div t-elif="!this.d.available" class="o_azm_card o_azm_empty">
            <i class="oi" data-icon="lock" title="No access"/>
            <strong>لا يتوفّر أي نموذج لحسابك</strong>
            <small>No model is available for your user — اطلب من المسؤول صلاحيات «نموذج التشغيل AZM».</small>
        </div>

        <t t-else="">
            <section class="o_azm_kpis o_azm_trees_kpis">
                <div t-foreach="this.totals" t-as="kpi" t-key="kpi.key"
                     t-attf-class="o_azm_kpi o_azm_kpi_static o_azm_tone_{{kpi.tone}}">
                    <span class="o_azm_kpi_text">
                        <span class="o_azm_kpi_label">
                            <t t-out="kpi.label"/>
                            <em class="o_azm_kpi_en" t-out="kpi.en"/>
                        </span>
                        <strong class="o_azm_kpi_value" t-out="kpi.value"/>
                        <small t-out="kpi.sub"/>
                        <small class="o_azm_en" t-out="kpi.sub_en"/>
                    </span>
                    <span class="o_azm_icon_badge">
                        <t t-if="kpi.mark" t-call="azm_platform.TreeMark"/>
                        <i t-else="" class="oi" t-att-data-icon="kpi.icon" t-att-title="kpi.label"/>
                    </span>
                </div>
            </section>

            <!-- the entities; opening one shows the trees it has -->
            <section t-if="!this.opened" class="o_azm_trees_grid o_azm_entities_grid">
                <article t-foreach="this.entities" t-as="e" t-key="e.company_id" role="button" tabindex="0"
                         t-attf-class="o_azm_tree_card o_azm_status_{{e.status}}"
                         t-att-aria-label="e.name"
                         t-on-click="() => this.openEntity(e)"
                         t-on-keydown="(ev) => this.onCardKey(ev, () => this.openEntity(e))">
                    <span t-attf-class="o_azm_tree_card_ribbon o_azm_ribbon_{{e.status}}">
                        <t t-out="e.status_label"/>
                        <em class="o_azm_en" t-out="e.status_en"/>
                    </span>

                    <header>
                        <img t-if="e.logoUrl" t-att-src="e.logoUrl" t-att-alt="e.name"/>
                        <span t-else="" class="o_azm_tree_card_mono" t-out="e.initials"/>
                        <strong t-out="e.name"/>
                        <small t-if="e.code" class="o_azm_code o_azm_code_dim" t-out="e.code"/>
                    </header>

                    <div class="o_azm_tree_card_body">
                        <span class="o_azm_ring_wrap">
                            <svg class="o_azm_ring" viewBox="0 0 40 40" aria-hidden="true">
                                <circle class="o_azm_ring_track" cx="20" cy="20" r="15.9155"/>
                                <circle t-if="e.completion" class="o_azm_ring_value" cx="20" cy="20" r="15.9155"
                                        t-attf-stroke-dasharray="{{this.bar(e.completion)}} 100"/>
                            </svg>
                            <b class="o_azm_ring_label" t-out="this.pct(e.completion)"/>
                        </span>

                        <dl class="o_azm_tree_card_figures">
                            <div t-foreach="e.trees" t-as="t" t-key="t.key" class="o_azm_chip">
                                <dt>
                                    <t t-out="t.name"/>
                                    <em class="o_azm_en" t-out="t.en"/>
                                </dt>
                                <dd t-out="this.pct(t.completion)"/>
                            </div>
                        </dl>
                    </div>

                    <footer>
                        <t t-call="azm_platform.TreeMark"/>
                        <span>
                            <t t-out="e.started"/> من <t t-out="e.trees.length"/> شجرة بدأت
                            <em class="o_azm_en"><t t-out="e.started"/> of <t t-out="e.trees.length"/> trees started</em>
                        </span>
                        <i class="oi o_azm_tree_card_go" data-icon="chevron_left" title="Open"/>
                    </footer>
                </article>
            </section>

            <t t-else="">
                <!-- one entity opened: the trees it has, each opening its own page -->
                <nav class="o_azm_trees_crumb">
                    <button type="button" class="btn btn-sm btn-light" t-on-click="() => this.closeEntity()">
                        <i class="oi" data-icon="chevron_right" title="Back"/>
                        الكيانات <em class="o_azm_en">Entities</em>
                    </button>
                    <span class="o_azm_trees_crumb_here">
                        <img t-if="this.opened.logoUrl" t-att-src="this.opened.logoUrl" t-att-alt="this.opened.name"/>
                        <span t-else="" class="o_azm_tree_card_mono" t-out="this.opened.initials"/>
                        <strong t-out="this.opened.name"/>
                        <small t-if="this.opened.code" class="o_azm_code o_azm_code_dim" t-out="this.opened.code"/>
                    </span>
                </nav>

                <div class="o_azm_trees_grid">
                    <article t-foreach="this.opened.trees" t-as="t" t-key="t.key" role="button" tabindex="0"
                             t-attf-class="o_azm_tree_card o_azm_trees_{{t.key}} o_azm_status_{{t.status}} o_azm_tone_{{t.tone}}"
                             t-att-aria-label="t.name"
                             t-on-click="() => this.openTree(this.opened, t)"
                             t-on-keydown="(ev) => this.onCardKey(ev, () => this.openTree(this.opened, t))">
                        <span t-attf-class="o_azm_tree_card_ribbon o_azm_ribbon_{{t.status}}">
                            <t t-out="t.status_label"/>
                            <em class="o_azm_en" t-out="t.status_en"/>
                        </span>

                        <header>
                            <span class="o_azm_icon_badge">
                                <i class="oi" t-att-data-icon="t.icon" t-att-title="t.name"/>
                            </span>
                            <strong>
                                <t t-out="t.name"/>
                                <em class="o_azm_en" t-out="t.en"/>
                            </strong>
                        </header>

                        <p class="o_azm_trees_desc">
                            <t t-out="t.desc"/>
                            <small class="o_azm_en" t-out="t.desc_en"/>
                        </p>

                        <div class="o_azm_tree_card_body">
                            <span class="o_azm_ring_wrap">
                                <svg class="o_azm_ring" viewBox="0 0 40 40" aria-hidden="true">
                                    <circle class="o_azm_ring_track" cx="20" cy="20" r="15.9155"/>
                                    <circle t-if="t.completion" class="o_azm_ring_value" cx="20" cy="20" r="15.9155"
                                            t-attf-stroke-dasharray="{{this.bar(t.completion)}} 100"/>
                                </svg>
                                <b class="o_azm_ring_label" t-out="this.pct(t.completion)"/>
                            </span>

                            <dl class="o_azm_tree_card_figures">
                                <div t-foreach="t.figures" t-as="f" t-key="f.key"
                                     t-attf-class="o_azm_chip {{f.tone and f.value ? 'o_azm_chip_warn' : ''}}">
                                    <dt>
                                        <t t-out="f.label"/>
                                        <em class="o_azm_en" t-out="f.en"/>
                                    </dt>
                                    <dd t-out="f.value"/>
                                </div>
                            </dl>
                        </div>

                        <footer>
                            <t t-call="azm_platform.TreeMark"/>
                            <span>
                                <t t-out="t.structure"/>
                                <em class="o_azm_en" t-out="t.path_en"/>
                            </span>
                            <i class="oi o_azm_tree_card_go" data-icon="chevron_left" title="Open"/>
                        </footer>
                    </article>
                </div>
            </t>

        </t>
    </div>
</t>

</templates>
