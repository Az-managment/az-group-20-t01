<?xml version="1.0" encoding="UTF-8"?>
<templates xml:space="preserve">
    <t t-inherit="azm_platform.EntityOverview" t-inherit-mode="extension">
        <xpath expr="//div[hasclass('o_azm_overview')]/section[1]" position="after">
            <section t-if="this.om" class="o_azm_card o_azm_om_home o_azm_om_entity">
                <header class="o_azm_card_header">
                    <h3>Operating Model</h3>
                    <a t-if="this.om.entities.length" href="#" t-on-click.prevent="() => this.openOm()">Open Operating Model</a>
                </header>
                <t t-if="this.om.entities.length" t-call="azm_platform.OmSummary"/>
                <div t-else="" class="o_azm_empty">
                    <i class="oi" data-icon="link_off" title="Not linked"/>
                    <strong>No Operating Model entity is linked to this company</strong>
                    <small>Link it from Operating Model › Settings › Entities (column “Company”).</small>
                    <button type="button" class="btn btn-primary btn-sm mt-2" t-on-click="() => this.openOmEntities()">Link an entity</button>
                </div>
            </section>
            <section t-if="this.fin and this.fin.kpis.entities" class="o_azm_card o_azm_om_home o_azm_om_entity">
                <header class="o_azm_card_header">
                    <h3>Unified Financial Model</h3>
                    <a href="#" t-on-click.prevent="() => this.openFin()">Open Financial Model</a>
                </header>
                <t t-call="azm_platform.FinSummary"/>
            </section>
        </xpath>
    </t>
</templates>
