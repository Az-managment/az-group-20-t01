<?xml version="1.0" encoding="UTF-8"?>
<templates xml:space="preserve">

    <!-- Reusable body: KPIs + the three domains + latest assessments / top risks -->
    <t t-name="azm_platform.OmSummary">
        <div class="o_azm_om_home_kpis">
            <div t-foreach="this.omKpis" t-as="kpi" t-key="kpi.key">
                <small t-out="kpi.label"/>
                <strong t-out="kpi.value"/>
                <span t-if="kpi.meter !== undefined" class="o_azm_progress"><span class="o_azm_progress_bar" t-attf-style="width: {{this.omBar(kpi.meter)}}%"/></span>
                <small t-if="kpi.sub" class="fw-normal" t-out="kpi.sub"/>
            </div>
        </div>
        <div class="o_azm_om_home_domains">
            <button type="button" t-foreach="this.omDomains" t-as="dom" t-key="dom.key"
                    t-attf-class="o_azm_om_home_domain o_azm_tone_{{dom.tone}}" t-on-click="() => this.openOm(dom.key)">
                <header>
                    <span t-attf-class="o_azm_icon_badge small o_azm_tone_{{dom.tone}}"><i class="oi" t-att-data-icon="dom.icon" t-att-title="dom.label"/></span>
                    <strong t-out="dom.label"/>
                </header>
                <span class="o_azm_mini_progress">
                    <span class="o_azm_progress"><span class="o_azm_progress_bar" t-attf-style="width: {{this.omBar(dom.completion)}}%"/></span>
                    <small t-out="this.omPct(dom.completion)"/>
                </span>
                <span class="o_azm_om_home_line"><span>Question areas · questions</span><b><t t-out="dom.stages"/> · <t t-out="dom.questions"/></b></span>
                <span class="o_azm_om_home_line"><span>Answer certainty</span><b t-out="this.omPct(dom.certainty)"/></span>
                <span class="o_azm_om_home_line"><span>Risks triggered</span><b t-out="dom.risks"/></span>
                <span class="o_azm_om_home_line"><span>Open findings</span><b t-att-class="{'text-danger': dom.findings_open}" t-out="dom.findings_open"/></span>
            </button>
        </div>
        <div class="o_azm_om_home_lists">
            <div>
                <h4>Latest assessments</h4>
                <ul t-if="this.om.assessments.length" class="o_azm_list">
                    <li t-foreach="this.om.assessments" t-as="row" t-key="row.id" t-on-click="() => this.openOmAssessment(row)">
                        <span class="flex-grow-1">
                            <strong><t t-out="row.name"/> · <t t-out="row.entity"/></strong>
                            <small><t t-out="row.kind"/> · <t t-out="row.state_label"/> · v<t t-out="row.version"/></small>
                        </span>
                        <span class="o_azm_mini_progress" style="width: 110px;">
                            <span class="o_azm_progress"><span class="o_azm_progress_bar" t-attf-style="width: {{this.omBar(row.completion)}}%"/></span>
                            <small t-out="this.omPct(row.completion)"/>
                        </span>
                    </li>
                </ul>
                <div t-else="" class="o_azm_empty"><small>No assessment yet</small></div>
            </div>
            <div>
                <h4>Top open risks</h4>
                <ul t-if="this.om.top_findings.length" class="o_azm_list">
                    <li t-foreach="this.om.top_findings" t-as="f" t-key="f.id" t-on-click="() => this.openOmFinding(f)">
                        <span t-attf-class="o_azm_om_score {{f.score >= 15 ? 'o_high' : (f.score >= 8 ? 'o_mid' : (f.score ? 'o_low' : ''))}}" t-out="f.score or '?'"/>
                        <span class="flex-grow-1">
                            <strong t-out="f.fact"/>
                            <small><t t-out="f.entity"/> · <t t-out="f.stage"/></small>
                        </span>
                    </li>
                </ul>
                <div t-else="" class="o_azm_empty"><small>No open findings</small></div>
            </div>
        </div>
    </t>

    <!-- Financial model block: KPIs + the 17 modules -->
    <t t-name="azm_platform.FinSummary">
        <div class="o_azm_om_home_kpis">
            <div t-foreach="this.finKpis" t-as="kpi" t-key="kpi.key">
                <small t-out="kpi.label"/>
                <strong t-out="kpi.value"/>
                <span t-if="kpi.meter !== undefined" class="o_azm_progress"><span class="o_azm_progress_bar" t-attf-style="width: {{this.omBar(kpi.meter)}}%"/></span>
                <small t-if="kpi.sub" class="fw-normal" t-out="kpi.sub"/>
            </div>
        </div>
        <div class="o_azm_fin_home_mods">
            <button type="button" t-foreach="this.finModules" t-as="mod" t-key="mod.code"
                    t-attf-class="o_azm_fin_home_mod o_azm_fin_hs_{{mod.status}}" t-on-click="() => this.openFin()"
                    t-att-title="mod.name">
                <span class="o_code" t-out="mod.code"/>
                <span class="o_name" t-out="mod.name"/>
                <span class="o_azm_progress"><span class="o_azm_progress_bar" t-attf-style="width: {{this.omBar(mod.completion)}}%"/></span>
                <small><t t-out="mod.done"/>/<t t-out="mod.applicable"/><t t-if="mod.gaps"> · <b t-out="mod.gaps"/> فجوة</t></small>
            </button>
        </div>
    </t>

    <t t-inherit="azm_platform.Dashboard" t-inherit-mode="extension">
        <xpath expr="//section[hasclass('o_azm_kpis')]" position="after">
            <section t-if="this.om" class="o_azm_card o_azm_om_home">
                <header class="o_azm_card_header">
                    <h3>Operating Model</h3>
                    <a href="#" t-on-click.prevent="() => this.openOm()">Open Operating Model</a>
                </header>
                <t t-call="azm_platform.OmSummary"/>
            </section>
            <section t-if="this.fin" class="o_azm_card o_azm_om_home">
                <header class="o_azm_card_header">
                    <h3>Unified Financial Model</h3>
                    <a href="#" t-on-click.prevent="() => this.openFin()">Open Financial Model</a>
                </header>
                <t t-call="azm_platform.FinSummary"/>
            </section>
        </xpath>
    </t>

</templates>
