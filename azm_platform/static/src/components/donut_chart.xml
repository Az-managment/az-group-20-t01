<?xml version="1.0" encoding="UTF-8"?>
<templates xml:space="preserve">
    <t t-name="azm_platform.DonutChart">
        <div class="o_azm_donut" t-attf-style="width: {{this.size}}px; height: {{this.size}}px;">
            <svg t-att-width="this.size" t-att-height="this.size" t-attf-viewBox="0 0 {{this.size}} {{this.size}}">
                <g t-attf-transform="rotate(-90 {{this.size / 2}} {{this.size / 2}})">
                    <circle t-foreach="this.segments" t-as="seg" t-key="seg.key"
                            t-att-cx="this.size / 2" t-att-cy="this.size / 2" t-att-r="this.radius"
                            fill="none" t-att-stroke="seg.color" t-att-stroke-width="this.thickness"
                            t-att-stroke-dasharray="seg.dash" t-att-stroke-dashoffset="seg.offset"
                            t-att-class="seg.muted ? 'o_azm_donut_muted' : ''">
                        <title t-out="seg.title"/>
                    </circle>
                </g>
            </svg>
            <div class="o_azm_donut_center">
                <strong t-out="this.centerText"/>
                <span t-if="this.subText" t-out="this.subText"/>
            </div>
        </div>
    </t>
</templates>
