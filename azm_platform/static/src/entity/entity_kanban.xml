<?xml version="1.0" encoding="UTF-8"?>
<templates xml:space="preserve">
    <t t-name="azm_platform.EntityKanbanRenderer" t-inherit="web.KanbanRenderer" t-inherit-mode="primary">
        <xpath expr="//div[hasclass('o_kanban_renderer')]" position="before">
            <AzmEntityStats/>
        </xpath>
    </t>

    <t t-name="azm_platform.EntityStats">
        <div t-if="this.state.stats" class="o_azm_entity_stats">
            <div class="o_azm_kpi">
                <span class="o_azm_kpi_text">
                    <span class="o_azm_kpi_label">Total Entities</span>
                    <strong class="o_azm_kpi_value" t-out="this.state.stats.total"/>
                </span>
                <span class="o_azm_icon_badge o_azm_tone_blue"><i class="oi" data-icon="business" title="Entities"/></span>
            </div>
            <div class="o_azm_kpi">
                <span class="o_azm_kpi_text">
                    <span class="o_azm_kpi_label">Active on Platform</span>
                    <strong class="o_azm_kpi_value" t-out="this.state.stats.active"/>
                </span>
                <span class="o_azm_icon_badge o_azm_tone_green"><i class="oi" data-icon="check_circle" title="Active"/></span>
            </div>
            <div class="o_azm_kpi">
                <span class="o_azm_kpi_text">
                    <span class="o_azm_kpi_label">In Preparation</span>
                    <strong class="o_azm_kpi_value" t-out="this.state.stats.in_progress"/>
                </span>
                <span class="o_azm_icon_badge o_azm_tone_purple"><i class="oi" data-icon="schedule" title="In Preparation"/></span>
            </div>
            <div class="o_azm_kpi">
                <span class="o_azm_kpi_text">
                    <span class="o_azm_kpi_label">Not Started</span>
                    <strong class="o_azm_kpi_value" t-out="this.state.stats.not_started"/>
                </span>
                <span class="o_azm_icon_badge o_azm_tone_slate"><i class="oi" data-icon="more_horiz" title="Not Started"/></span>
            </div>
            <div class="o_azm_kpi o_azm_kpi_wide">
                <span class="o_azm_kpi_text">
                    <span class="o_azm_kpi_label">Entity Types</span>
                    <small t-out="this.state.stats.types.join(' – ')"/>
                </span>
                <span class="o_azm_icon_badge o_azm_tone_indigo"><i class="oi" data-icon="group" title="Types"/></span>
            </div>
            <div class="o_azm_kpi o_azm_kpi_wide">
                <span class="o_azm_kpi_text">
                    <span class="o_azm_kpi_label">Overall Task Completion</span>
                    <span class="o_azm_mini_progress">
                        <span class="o_azm_progress"><span class="o_azm_progress_bar" t-attf-style="width: {{this.progressWidth}}%"/></span>
                        <strong t-out="this.progressLabel"/>
                    </span>
                </span>
                <span class="o_azm_icon_badge o_azm_tone_blue"><i class="oi" data-icon="bar_chart" title="Progress"/></span>
            </div>
        </div>
    </t>
</templates>
